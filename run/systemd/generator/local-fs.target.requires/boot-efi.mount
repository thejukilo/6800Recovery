# Automatically generated by systemd-fstab-generator

[Unit]
Documentation=man:fstab(5) man:systemd-fstab-generator(8)
SourcePath=/etc/fstab
Before=local-fs.target
Requires=systemd-fsck@dev-disk-by\x2duuid-15E6\x2d8E7B.service
After=systemd-fsck@dev-disk-by\x2duuid-15E6\x2d8E7B.service
After=blockdev@dev-disk-by\x2duuid-15E6\x2d8E7B.target

[Mount]
What=/dev/disk/by-uuid/15E6-8E7B
Where=/boot/efi
Type=vfat
