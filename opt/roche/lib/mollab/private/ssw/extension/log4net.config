<?xml version="1.0" encoding="utf-8" ?>
<log4net>
  <appender name="Trace" type="log4net.Appender.RollingFileAppender">
    <file type="log4net.Util.PatternString" value="/data/shared/logs/LabCoreDiagnose.log"  />
    <appendToFile value="true" />
    <rollingStyle value="Date" />
    <datePattern value="_yyyyMMdd"/>
    <maxSizeRollBackups value="3" />
    <maximumFileSize value="2MB" />
    <encoding value="utf-8" />
    <immediateFlush value="true" />
    <staticLogFileName value="false" />
    <preserveLogFileNameExtension value="true"/>
    <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="[%utcdate][SSW][%level][%logger][%thread]%message %exception[EOL]%newline" />
    </layout>
  </appender>
  <appender name="Console" type="log4net.Appender.ManagedColoredConsoleAppender">
    <mapping>
      <level value="INFO" />
      <forecolor value="White" />
    </mapping>
    <mapping>
      <level value="ERROR" />
      <forecolor value="Red" />
    </mapping>
    <mapping>
      <level value="FATAL" />
      <forecolor value="Red" />
    </mapping>
    <mapping>
      <level value="WARN" />
      <forecolor value="Yellow" />
    </mapping>
    <mapping>
      <level value="DEBUG" />
      <forecolor value="Green" />
    </mapping>
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date %-5level %logger: %message%newline" />
    </layout>
  </appender>
  <root>
    <level value="Info" />
    <appender-ref ref="Trace" />
  </root>
</log4net>