{
  "messaging.rabbitmq": {
    "name": "SSW",
    "hostName": "rabbitmq-server",    
    "distributionChannels": [
      {
        "name": "DistributionChannel",        
        "bindRequestSubscriptionsToQueue": true,
        "bindEventSubscriptionsToQueue": true,
        "requestExchangeName": "roche.requests.dx",
        "eventExchangeName": "roche.events.tx",
        "createTopology" : true,
        "queueName": "roche.newgen.ssw.q"       
      }
    ],
    "publicationChannels": [
      {
        "name": "Publication",
        "createTopology" : true
      }
    ]
  },
  "pipettingParameterFileDeploymentSettings": {
    "pipettingParameterFileSourceFolder": "/data/extension/pipetting-parameter-sets",
    "testDefinitionPipettingParameterFileSourceFolder": "/data/shared/test-definition-data/Instrument/6800_8800/PipettingParameterFiles",
    "sampleTransferPipettingParameterFileTargetFolder": "/data/shared/tmp/pipetting-parameter-sets/sample-transfer",
    "sampleTransferPipettingParameterGroupingIdentifier": "SampleHead",
    "reagentTransferAPipettingParameterFileTargetFolder": "/data/shared/tmp/pipetting-parameter-sets/reagent-transfer-a",
    "reagentTransferAPipettingParameterGroupingIdentifier": "ReagentHead",
    "processTransferAPipettingParameterFileTargetFolder": "/data/shared/tmp/pipetting-parameter-sets/process-transfer-a",
    "processTransferAPipettingParameterGroupingIdentifier": "ProcessHead"
  },
  "executionRecordConfig": {
    "targetOutputFile": "/data/shared/lastSuccessfulExecutions.json",
    "checksOfInterestMapping": {
      "ProcessingModuleAFlushCheckCommon": "ProcessingModuleAFlush",
      "ProcessingModuleADryCheckCommon": "ProcessingModuleADry",
      "ProcessTransferHeadTightnessCheckAACommon": "ProcessTransferHeadTightnessCheckAA",
      "ProcessTransferHeadTightnessCheckABCommon": "ProcessTransferHeadTightnessCheckAB"
    }
  },
  "performanceMonitoring": {
    "eventCounters": {
      "enabled": true,
      "intervalSeconds": 30,
      "counters": [
        {
          "name": "cpu-usage",
          "eventSource": "System.Runtime"
        },
        {
          "name": "working-set",
          "eventSource": "System.Runtime"
        },
        {
          "name": "gc-heap-size",
          "eventSource": "System.Runtime"
        },
        {
          "name": "gc-fragmentation",
          "eventSource": "System.Runtime"
        },
        {
          "name": "alloc-rate",
          "eventSource": "System.Runtime"
        },
        {
          "name": "time-in-gc",
          "eventSource": "System.Runtime"
        },
        {
          "name": "threadpool-queue-length",
          "eventSource": "System.Runtime"
        },
        {
          "name": "threadpool-completed-items-count",
          "eventSource": "System.Runtime"
        },
        {
          "name": "monitor-lock-contention-count",
          "eventSource": "System.Runtime"
        },
        {
          "name": "active-timer-count",
          "eventSource": "System.Runtime"
        },
        {
          "name": "exception-count",
          "eventSource": "System.Runtime"
        }
      ]
    }
  }
}