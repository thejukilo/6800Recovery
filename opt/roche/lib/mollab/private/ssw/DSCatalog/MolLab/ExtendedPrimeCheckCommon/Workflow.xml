              <base:Paragraph>From the Wash Reagent 1 to the Wash Reagent Reservoir [R.irUiVolumeStep14Ml] ml</base:Paragraph>
              <base:Paragraph>From the Wash reagent reservoir to the Overflow Container</base:Paragraph>
              <base:Paragraph>(via S1 - S4 - S7 - Wash Buffer Pump - S8 - Wash Reagent Reservoir - S24 - S25)</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="WashReagentReservoirToWashStationToOverflowContainerActionCommon">
        <workflow:GUI>
          <workflow:Description>
            <base:Title>Overflow Container</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Please wait while process is running...</base:Paragraph>
              <base:Paragraph />
              <base:Paragraph>From the Wash Reagent Reservoir to the Wash Station [R.irUiVolumeStep15Ml] ml</base:Paragraph>
              <base:Paragraph>From the Wash Station to Overflow Container</base:Paragraph>
              <base:Paragraph>(via S9 - Reagent Transfer Head - Wash Station - S41)</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="OpenDownholder">
        <workflow:GUI>
          <workflow:Description>
            <base:Title>Open Downholder</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Please wait while the downholders are opening...</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="RemoveRacks" Type="Next">
        <workflow:GUI>
          <workflow:Description>
            <base:Title>Remove Tip Rack And Waste Inserts</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Please remove both tip racks and waste inserts then press 'Next'.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <!-- Requirement step 33: Drain & Verify Overflow Bottle -->
      <ds:Step Name="DrainWashStation">
        <workflow:GUI>
          <workflow:Description>
            <base:Title>Draining</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Draining wash station...</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="VisualCheckOfOverflowBottleNext" Type="Next">
        <workflow:GUI>
          <workflow:Description>
            <base:Title>Clean Up</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Please check the Overflow Container and empty it.</base:Paragraph>
              <base:Paragraph>Please press 'Next' to continue.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
        <workflow:Flow>
          <workflow:Decision Result="irEmptyLiquidWaste" NextStep="OpenWashWasteDrawerAction">
            <workflow:Condition Operator="EQ" Value="true" />
          </workflow:Decision>
          <workflow:Decision Result="irEmptyLiquidWaste" NextStep="Completed">
            <workflow:Condition Operator="EQ" Value="false" />
          </workflow:Decision>
        </workflow:Flow>
      </ds:Step>
      <!-- Requirement step 32 a) unlocks and pushes out the wash/waste drawer -->
      <ds:Step Name="OpenWashWasteDrawerAction">
        <workflow:GUI>
          <workflow:Description>
            <base:Title>Opening Wash/Waste Drawer</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Please wait while the wash/waste drawer is openend.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <!-- Requirement step 32 b) instructs the user to completely open the wash/waste drawer -->
      <ds:Step Name="OpenWashWasteDrawerInfo" Type="Next">
        <workflow:GUI>
          <workflow:Description>
            <base:Title>Open Wash/Waste Drawer Completely</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Please open the wash/waste drawer of the processing module completely and then press 'Next'.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <!-- Requirement step 32 c) unlocks all waste dispense caps of the liquid waste container positions -->
      <ds:Step Name="UnlockLiquidWaste">
        <workflow:GUI>
          <workflow:Description>
            <base:Title>Liquid Waste Container</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Unlock the liquid waste containers in all the liquid waste positions.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <!-- Requirement step 32 
            d) instructs the user to pull out the liquid waste drawer,
            e) instructs the user to empty all empty liquid waste containers and to close the waste dispense caps -->
      <ds:Step Name="ReplaceLiquidWaste">
        <workflow:GUI>
          <workflow:Description>
            <base:Title>Liquid Waste Container</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Please load an empty liquid waste container in all the liquid waste positions.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <!-- Requirement step 32 
            f) instructs the user to push in the liquid waste drawer,
            g) instructs the user to close the wash/waste drawer. -->
      <ds:Step Name="UserCloseWasteDrawer" Type="Next">
        <workflow:GUI>
          <workflow:Description>
            <base:Title>Close Wash/Waste Drawer</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Please close the wash/waste drawer and press 'Next'...</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="Completed" NextState="true">
        <workflow:GUI>
          <workflow:Description>
            <base:Title>Clean Up</base:Title>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
    </ds:WorkFlow>
  </ds:TestFunction>
</ds:TestList>