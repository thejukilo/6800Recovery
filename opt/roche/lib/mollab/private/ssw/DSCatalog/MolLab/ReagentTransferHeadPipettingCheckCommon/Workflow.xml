<?xml version="1.0" encoding="utf-8"?>
<ds:TestList Hash="F92F5140659F9B99C7230B59488D902596F9FA5E3BC0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:data="urn:data" xmlns:base="urn:base" xmlns:workflow="urn:workflow" xmlns:ds="urn:ds" xsi:schemaLocation="urn:ds ../../../Tools/Schemas/LabCore.Diagnose/dsWorkflow.xsd">
  <ds:TestFunction Name="ReagentTransferHeadPipettingCheckCommon" ID="TRQ565706">
    <base:Content>
      <base:File Type="Workflow" Version="1.0.0.0000" />
    </base:Content>
    <ds:WorkFlow>
      <ds:Step Name="PrepareInitStart" NextState="true">
        <workflow:GUI>
          <workflow:Description>
            <base:Title>Initialization</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Modules are being initialized...</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="PrepareInit">
        <workflow:GUI>
          <workflow:Description>
            <base:Title>Initialization</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Please wait while the process is running...</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <!-- Requirement step 3 -->
      <ds:Step Name="LoadCheck">
        <workflow:GUI>
          <!-- Auto generated text, adjust in Unit.SSW/Source/CommonCheckComponents/LoadCheck/LoadCheckSteps.xml -->
          <workflow:Description>
            <base:Title>Load Check</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Checking if enough bulk reagents are loaded.</base:Paragraph>
              <base:Paragraph />
              <base:Paragraph>Hint: When the wash reagent reservoir needs to be filled, this step will take more time.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
        <workflow:Flow>
          <workflow:Decision Result="irLoadCheckSuccessful" NextStep="ConnectBalanceCheck">
            <workflow:Condition Operator="EQ" Value="True" />
          </workflow:Decision>
        </workflow:Flow>
      </ds:Step>
      <ds:Step Name="LoadMissingBulkReagents" Type="Next">
        <workflow:GUI>
          <!-- Auto generated text, adjust in Unit.SSW/Source/CommonCheckComponents/LoadCheck/LoadCheckSteps.xml -->
          <workflow:Description>
            <base:Title>Load Missing Bulk Reagents</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Bulk reagent check loading state:</base:Paragraph>
              <base:Paragraph>[R.irLoadCheckPrerequisiteLine1]</base:Paragraph>
              <base:Paragraph>[R.irLoadCheckPrerequisiteLine2]</base:Paragraph>
              <base:Paragraph>[R.irLoadCheckPrerequisiteLine3]</base:Paragraph>
              <base:Paragraph />
              <base:Paragraph>Open the drawer and load the missing bulk reagents. Afterwards close the intakes, the drawer and confirm by pressing Next.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
        <workflow:Flow>
          <workflow:Decision Result="irLoadCheckSuccessful" NextStep="LoadCheck">
            <workflow:Condition Operator="EQ" Value="False" />
          </workflow:Decision>
        </workflow:Flow>
      </ds:Step>
      <!-- Requirement step 4 & 5 -->
      <ds:Step Name="ConnectBalanceCheck">
        <workflow:GUI>
          <workflow:Description>
            <base:Title>Preparation</base:Title>
            <base:Paragraphs>
              <base:Paragraph>The connection to the onboard weighing system is now being checked.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <!-- Requirement step 6 -->
      <ds:Step Name="DrainWashStation">
        <workflow:GUI>
          <workflow:Description>
            <base:Title>Drain Wash Station</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Draining the wash station...</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="CloseBlind">
        <workflow:GUI>
          <workflow:Description>
            <base:Title>Preparation</base:Title>
            <base:Paragraphs>
              <base:Paragraph>The airflow screen is being closed.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="TareBalance">
        <workflow:GUI>
          <workflow:Description>
            <base:Title>Preparation</base:Title>
            <base:Paragraphs>
              <base:Paragraph>The onboard weighing system is being tared.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="PerformInitialDispense">
        <workflow:GUI>
          <workflow:Description>
            <base:Title>Pipetting</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Please wait while the pipetting check is running...</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="PerformMultiDispense" Type="Auto">
        <workflow:GUI>
          <workflow:Description>
            <base:Title>Pipetting</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Please wait while the pipetting check is running...</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="PerformMultiDispenseLowVolume" Type="Auto">
        <workflow:GUI>
          <workflow:Description>
            <base:Title>Pipetting</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Please wait while the pipetting check is running...</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="Calculation">
        <workflow:GUI>
          <workflow:Description>
            <base:Title>Calculation</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Please wait while the process is running...</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="CleanUp">
        <workflow:GUI>
          <workflow:Description>
            <base:Title>Cleanup</base:Title>
            <base:Paragraphs>
              <base:Paragraph>The reagent transfer head is draining the onboard weighing system weigh boat.</base:Paragraph>
              <base:Paragraph>The reagent transfer head is washed and parked.</base:Paragraph>
              <base:Paragraph>Caution: The heads are moving when you press 'Next'.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
    </ds:WorkFlow>
  </ds:TestFunction>
</ds:TestList>