    <group:TestFunction Name="SampleTransferHeadPipettingIntroCheckCommon">
      <!-- Auto-Generated text from description file. -->
      <product:Description>
        <base:Title>Sample transfer head pipetting intro</base:Title>
        <base:Paragraphs>
          <base:Paragraph>It helps to install the onboard weighing system (OWS) in the transfer module and to prepare all the material required to perform the test.</base:Paragraph>
          <base:Paragraph>-----------------------------------------------------------------------------------------------</base:Paragraph>
          <base:Paragraph>Preconditions:</base:Paragraph>
          <base:Paragraph>- The cobas omni secondary tubes have to be filled with at least 1.2ml of cobas omni wash reagent</base:Paragraph>
          <base:Paragraph>- No consumables on transfer module deck</base:Paragraph>
          <base:Paragraph>-----------------------------------------------------------------------------------------------</base:Paragraph>
          <base:Paragraph>Required Time: 7 minutes</base:Paragraph>
          <base:Paragraph>-----------------------------------------------------------------------------------------------</base:Paragraph>
          <base:Paragraph>Required Equipment:</base:Paragraph>
          <base:Paragraph>- 1 onboard weighing system (OWS)</base:Paragraph>
          <base:Paragraph>- 1 tool holder for balance</base:Paragraph>
          <base:Paragraph>- 1 5-position rack without stabilizers (MPA rack)</base:Paragraph>
          <base:Paragraph>- 5 cobas omni secondary tubes, each filled with a minimum of 1.2 ml wash reagent</base:Paragraph>
          <base:Paragraph>- 2 cobas omni pipette tips</base:Paragraph>
          <base:Paragraph>-----------------------------------------------------------------------------------------------</base:Paragraph>
          <base:Paragraph>Supported balance - holder combinations:</base:Paragraph>
          <base:Paragraph> - WMC15-SH/01 (fix mounted spirit level and cable) + holder for WMC15-SH/01 (blue cable fixations)</base:Paragraph>
          <base:Paragraph> - WMC15-SH/01 (fix mounted spirit level and cable) + holder for SPC115-100 (spirit level cut out, black velcro cable fixation)</base:Paragraph>
          <base:Paragraph> - SPC115-100 (no fix mounted spirit level and cable) + holder for SPC115-100 (spirit level cut out, black velcro cable fixation)</base:Paragraph>
          <base:Paragraph>-----------------------------------------------------------------------------------------------</base:Paragraph>
          <base:Paragraph>Hint: At the beginning of the check, the two onboard weighing systems/holders will be illustrated.</base:Paragraph>
        </base:Paragraphs>
      </product:Description>
    </group:TestFunction>
    <group:TestFunction Name="BalanceCalibrationCheckSampleHeadCommon">
      <!-- Auto-Generated text from description file. -->
      <product:Description>
        <base:Title>Sample transfer head OWS calibration</base:Title>
        <base:Paragraphs>
          <base:Paragraph>Calibrates the balance.</base:Paragraph>
          <base:Paragraph>-----------------------------------------------------------------------------------------------</base:Paragraph>
          <base:Paragraph>Preconditions:</base:Paragraph>
          <base:Paragraph>- The instrument is in interlock service mode</base:Paragraph>
          <base:Paragraph>- Transfer module front cover is opened</base:Paragraph>
          <base:Paragraph>- Sample transfer head pipetting intro command was executed</base:Paragraph>
          <base:Paragraph>- It is recommended to have the balance powered on for 30 minutes before executing the check</base:Paragraph>
          <base:Paragraph>-----------------------------------------------------------------------------------------------</base:Paragraph>
          <base:Paragraph>Required Time: 5 minutes</base:Paragraph>
          <base:Paragraph>-----------------------------------------------------------------------------------------------</base:Paragraph>
          <base:Paragraph>Required Equipment: </base:Paragraph>
          <base:Paragraph>- The balance and weighing pan </base:Paragraph>
          <base:Paragraph>- 1 Mettler Toledo pair of tweezers</base:Paragraph>
          <base:Paragraph>- 1 Mettler Toledo calibration standard weight (10g)</base:Paragraph>
          <base:Paragraph>-----------------------------------------------------------------------------------------------</base:Paragraph>
          <base:Paragraph>Required consumables/reagents: None </base:Paragraph>
        </base:Paragraphs>
      </product:Description>
    </group:TestFunction>
    <group:TestFunction Name="SampleTransferHeadPipettingFillBalanceCheckCommon">
      <!-- Auto-Generated text from description file. -->
      <product:Description>
        <base:Title>Sample transfer head pipetting fill OWS</base:Title>
        <base:Paragraphs>
          <base:Paragraph>It dispenses the correct liquid volume on weighing cup of the onboard weighing system.</base:Paragraph>
          <base:Paragraph />
          <base:Paragraph>Note: If an error occurs during aspiration, the used tip will be dropped at the rear of the transfer module and the check will fail. The dropped tip needs to be cleaned up manually</base:Paragraph>
          <base:Paragraph>-----------------------------------------------------------------------------------------------</base:Paragraph>
          <base:Paragraph>Preconditions: The sample transfer head pipetting intro and onboard weighing system calibration must be performed</base:Paragraph>
          <base:Paragraph>-----------------------------------------------------------------------------------------------</base:Paragraph>
          <base:Paragraph>Required Time: 5 minutes</base:Paragraph>
          <base:Paragraph>-----------------------------------------------------------------------------------------------</base:Paragraph>
          <base:Paragraph>Required Equipment: None</base:Paragraph>
        </base:Paragraphs>
      </product:Description>
    </group:TestFunction>
    <group:TestFunction Name="SampleTransferHeadPipettingACommon">
