<?xml version="1.0" encoding="utf-8"?>
<ds:TestList Hash="EB1B7361457A51925DDB232B91A70884431B9878A7C4" xmlns:base="urn:base" xmlns:data="urn:data" xmlns:ds="urn:ds" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="urn:ds ../../../Tools/Schemas/LabCore.Diagnose/dsData.xsd">
  <ds:TestFunction Name="ReagentHeadTeachCheckCommon">
    <base:Content>
      <base:File Type="Data" Version="1.0.0.0000" />
    </base:Content>
    <ds:Data>
      <data:ParameterList>
        <data:Parameter Name="pRequiredWashReagentVolume" Type="Double" Unit="m^3">
          <data:Description>
            <base:Title>Required Wash Reagent Volume</base:Title>
          </data:Description>
          <data:Value>162E-6</data:Value>
        </data:Parameter>
        <data:Parameter Name="pRequiredLiquidWasteVolume" Type="Double" Unit="m^3">
          <data:Description>
            <base:Title>Required Liquid Waste Volume</base:Title>
          </data:Description>
          <data:Value>412E-6</data:Value>
        </data:Parameter>
        <data:Parameter Name="pInnerWashVolume" Type="Double" Unit="m^3">
          <data:Description>
            <base:Title>WashVolume</base:Title>
          </data:Description>
          <data:Value>104E-6</data:Value>
        </data:Parameter>
        <data:Parameter Name="pOuterWashVolume" Type="Double" Unit="m^3">
          <data:Description>
            <base:Title>WashVolume</base:Title>
          </data:Description>
          <data:Value>8E-6</data:Value>
        </data:Parameter>
        <data:Parameter Name="pModuleId" Type="String">
          <data:Description>
            <base:Title>ID of the involved processing module</base:Title>
          </data:Description>
        </data:Parameter>
        <data:Parameter Name="pPipParams" Type="String">
          <data:Description>
            <base:Title>The pipetting parameter set to be used</base:Title>
          </data:Description>
          <data:Value>8893befa-0be7-4846-95c5-8c2c7bf6b6f1</data:Value>
        </data:Parameter>
        <data:Parameter Name="pIsOperationsCheck" Type="Boolean">
          <data:Description>
            <base:Title>'True' means check is being executed in the 'operations' environment.</base:Title>
          </data:Description>
          <data:Value>False</data:Value>
        </data:Parameter>
      </data:ParameterList>
      <data:ResultList>
        <data:Result Name="rTeaching" Type="Boolean">
          <data:Description>
            <base:Title>Teaching Successful</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Teaching Successful</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Validation>
            <data:Condition Operator="EQ" Value="True" />
          </data:Validation>
        </data:Result>
        <data:Result Type="Boolean" Name="irIsTaught">
          <data:Description>
            <base:Title>Reagent Head Taught</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Indicates whether the Reagent Head was already taught.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
        </data:Result>
        <data:Result Name="irLoadCheckPrerequisiteLine1" Type="String">
          <data:Description>
            <base:Title>Load Check Prerequisite 1</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Container which requires more volume.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
        </data:Result>
        <data:Result Name="irLoadCheckPrerequisiteLine2" Type="String">
          <data:Description>
            <base:Title>Load Check Prerequisite 2</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Container which requires more volume.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
        </data:Result>
        <data:Result Name="irLoadCheckPrerequisiteLine3" Type="String">
          <data:Description>
            <base:Title>Load Check Prerequisite 3</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Container which requires more volume.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
        </data:Result>
        <data:Result Type="Boolean" Name="irLoadCheckSuccessful">
          <data:Description>
            <base:Title>Load Check Was Successful</base:Title>
            <base:Paragraphs>
              <base:Paragraph>All the required bulk reagents were loaded successfully.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
        </data:Result>
      </data:ResultList>
    </ds:Data>
