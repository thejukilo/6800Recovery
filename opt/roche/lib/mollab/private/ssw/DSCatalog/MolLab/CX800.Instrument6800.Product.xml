  <ds:TestFunction Name="InstrumentTeachCheck6800">
    <!-- Auto-Generated text from description file. -->
    <product:Description>
      <base:Title>Instrument teach 6800</base:Title>
      <base:Paragraphs>
        <base:Paragraph>Performs the teach function of the instrument.</base:Paragraph>
        <base:Paragraph>-----------------------------------------------------------------------------------------------</base:Paragraph>
        <base:Paragraph>Preconditions:</base:Paragraph>
        <base:Paragraph>- The instrument is in interlock service mode</base:Paragraph>
        <base:Paragraph>- The front cover of the transfer module is opened</base:Paragraph>
        <base:Paragraph>- The teach tool is present on the teach tool park position in the transfer module</base:Paragraph>
        <base:Paragraph>- Reagent storage elevator adjustment executed beforehand</base:Paragraph>
        <base:Paragraph>- Transfer module drawer, processing module drawer and amplification plate waste drawer are closed</base:Paragraph>
        <base:Paragraph>-----------------------------------------------------------------------------------------------</base:Paragraph>
        <base:Paragraph>Required Time: 16 minutes</base:Paragraph>
        <base:Paragraph>-----------------------------------------------------------------------------------------------</base:Paragraph>
        <base:Paragraph>Required Equipment:</base:Paragraph>
        <base:Paragraph>- Pre-teach tool</base:Paragraph>
        <base:Paragraph>- Teach tool</base:Paragraph>
        <base:Paragraph>-----------------------------------------------------------------------------------------------</base:Paragraph>
        <base:Paragraph>Required bulk reagent and waste volumes (will be checked automatically and can be loaded during execution):</base:Paragraph>
        <base:Paragraph>- 162 ml wash reagent in the wash reagent reservoir,</base:Paragraph>
        <base:Paragraph> else 1000 ml in wash reagent container to fill the wash reagent reservoir</base:Paragraph>
        <base:Paragraph>- 412 ml liquid waste capacity (300 ml tolerance included)</base:Paragraph>
      </base:Paragraphs>
    </product:Description>
    <test:Files>
      <test:Workflow Version="1.0.0.0000" />
      <test:Data Version="1.0.0.0000" />
      <test:Assembly Version="1.0.0.0000" />
    </test:Files>
  </ds:TestFunction>
  <ds:TestFunction Name="InstrumentTightnessCheck6800">
    <!-- Auto-Generated text from description file. -->
    <product:Description>
      <base:Title>Instrument tightness check 6800</base:Title>
      <base:Paragraphs>
        <base:Paragraph>Perform the tightness check on the instrument.</base:Paragraph>
        <base:Paragraph>-----------------------------------------------------------------------------------------------</base:Paragraph>
        <base:Paragraph>Preconditions:</base:Paragraph>
        <base:Paragraph>- The teach tool is present on the teach tool park position of the transfer module.</base:Paragraph>
        <base:Paragraph>- The sample transfer head, reagent transfer head, the processing transfer heads and main handler are taught.</base:Paragraph>
        <base:Paragraph>- Service functions executed: Extended prime</base:Paragraph>
        <base:Paragraph>- Transfer positions empty</base:Paragraph>
        <base:Paragraph>-----------------------------------------------------------------------------------------------</base:Paragraph>
        <base:Paragraph>Required Time: 10 minutes</base:Paragraph>
        <base:Paragraph>-----------------------------------------------------------------------------------------------</base:Paragraph>
        <base:Paragraph>Required bulk reagent and waste volumes (will be checked automatically and can be loaded during execution):</base:Paragraph>
