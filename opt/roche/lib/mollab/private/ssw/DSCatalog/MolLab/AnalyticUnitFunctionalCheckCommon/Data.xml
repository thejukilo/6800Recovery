  <ds:TestFunction Name="AnalyticUnitFunctionalCheckCommon">
    <base:Content>
      <base:File Type="Data" Version="1.0.0.0000" />
    </base:Content>
    <ds:Data>
      <data:ParameterList>
        <data:Parameter Name="pAnalyticUnit" Type="String">
          <data:Description>
            <base:Title>Analytic Unit</base:Title>
          </data:Description>
        </data:Parameter>
        <data:Parameter Type="String" Name="ADProcessDefinitionFile">
          <data:Description>
            <base:Title>The Filename from the ADProcessDefinition XML file.</base:Title>
          </data:Description>
          <data:Value>ADImprecisionRun.xml</data:Value>
        </data:Parameter>
      </data:ParameterList>
      <data:ResultList>
        <data:Result Name="rImprecisionChannel1" Type="Double">
          <data:Description>
            <base:Title>Imprecision Channel 1</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Shows the imprecision of the Channel 1 in percent.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Validation>
            <data:Condition Operator="LE" Value="0.5" />
          </data:Validation>
        </data:Result>
        <data:Result Name="rInhomogeneityChannel1" Type="Double">
          <data:Description>
            <base:Title>Inhomogeneity Channel 1</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Shows the Inhomogeneity of the Channel 1 in percent.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Validation>
            <data:Condition Operator="LE" Value="70" />
          </data:Validation>
        </data:Result>
        <data:Result Name="rMinimumExcitationPowerChannel1" Type="Double">
          <data:Description>
            <base:Title>Minimum Excitation Power Channel 1</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Shows the minimum measured excitation power of channel 1.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
        </data:Result>
        <data:Result Name="rStoredMinimumExcitationPowerChannel1" Type="Double">
          <data:Description>
            <base:Title>Minimum Eeprom Led Intensity Channel 1</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Shows the minimum LED intensity from the EEPROM of channel 1.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
        </data:Result>
        <data:Result Name="rValidExcitationPowerChannel1" Type="Boolean">
          <data:Description>
            <base:Title>Valid Excitation Power Channel 1</base:Title>
            <base:Paragraphs>
              <base:Paragraph>The measured excitation power is greater than or equal to the stored excitation power for channel 1.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Validation>
            <data:Condition Operator="EQ" Value="True" />
