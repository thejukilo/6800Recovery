            <base:Title>Home Position Reached</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Instrument has been moved back to the home position.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Validation>
            <data:Condition Operator="EQ" Value="True" />
          </data:Validation>
        </data:Result>
      </data:ResultList>
