    </base:Content>
    <ds:Data>
      <data:ParameterList />
      <data:ResultList>
        <data:Result Type="Boolean" Name="EnableMovablePlatform">
          <data:Description>
            <base:Title>Enable Movable Platform</base:Title>
            <base:Paragraphs>
              <base:Paragraph>The movable platform was successfully enabled.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Validation>
            <data:Condition Operator="EQ" Value="True" />
          </data:Validation>
        </data:Result>
        <data:Result Type="Boolean" Name="MovablePlatformInterlockUnlocked">
          <data:Description>
            <base:Title>Movable Interlock Module Unlocked</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Interlock module for movable platform is unlocked.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Validation>
            <data:Condition Operator="EQ" Value="True" />
          </data:Validation>
        </data:Result>
        <data:Result Type="Boolean" Name="MaintenancePositionReached">
          <data:Description>
            <base:Title>Maintenance Position Reached</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Instrument has been moved to the maintenance position.</base:Paragraph>
