<?xml version="1.0" encoding="utf-8"?>
<ds:TestList Hash="D61A61C9BA9BC57268B1B3D8C5264799C77740CA9685" xmlns:workflow="urn:workflow" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:base="urn:base" xmlns:data="urn:data" xmlns:ds="urn:ds" xsi:schemaLocation="urn:ds ../../../Tools/Schemas/LabCore.Diagnose/dsWorkflow.xsd">
  <ds:TestFunction Name="SampleTransferHeadTightnessCheckCommon" ID="[RQ46874]">
    <base:Content>
      <base:File Type="Workflow" Version="1.0.0.0000" />
    </base:Content>
    <ds:WorkFlow>
      <ds:Step Name="Prepare" NextState="true">
        <workflow:GUI>
          <workflow:Description>
            <base:Title>Initialization</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Please wait while the process is running...</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
        <workflow:Flow NextStep="VerifyTeachToolPresence" />
      </ds:Step>
      <ds:Step Name="PlaceTeachTool" Type="Next">
        <workflow:GUI>
          <workflow:Description>
            <base:Title>Teach Tool</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Please place the teach tool on the teach tool park position of the transfer module.</base:Paragraph>
              <base:Paragraph>Please press 'Next' to continue.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
          <workflow:Picture Name="Location_teach_tool_park_position.jpg" Hash="AECA0756414AB534A583E942B147C8F1703DEB72" />
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="VerifyTeachToolPresence">
        <workflow:GUI>
          <workflow:Description>
            <base:Title>Verifying Teach Tool Presence</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Please wait while the light barrier of the teach tool park position is checked...</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
        <workflow:Flow>
          <workflow:Decision Result="irTeachToolPresent" NextStep="PlaceTeachTool">
            <workflow:Condition Operator="EQ" Value="False" />
          </workflow:Decision>
        </workflow:Flow>
      </ds:Step>
      <ds:Step Name="TightnessCheck">
        <workflow:GUI>
          <workflow:Description>
            <base:Title>Tightness Check</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Please wait while the tightness of the pipettors is checked...</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
      <ds:Step Name="Completed" NextState="true">
        <workflow:GUI>
          <workflow:Description>
            <base:Title>Check Completed</base:Title>
            <base:Paragraphs>
              <base:Paragraph>The check is completed.</base:Paragraph>
            </base:Paragraphs>
          </workflow:Description>
        </workflow:GUI>
      </ds:Step>
    </ds:WorkFlow>
  </ds:TestFunction>
</ds:TestList>