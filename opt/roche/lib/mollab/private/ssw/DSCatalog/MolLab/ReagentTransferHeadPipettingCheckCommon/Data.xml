          <data:Value>0E-09</data:Value>
        </data:Parameter>
        <data:Parameter Name="pWashVolumeInCubicMeters" Type="Double" Unit="m^3">
          <data:Description>
            <base:Title>Wash volume</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Wash volume</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Value>40E-6</data:Value>
        </data:Parameter>
        <data:Parameter Name="pInitialDispenseMaxInaccuracy" Type="Double" Unit="%">
          <data:Description>
            <base:Title>Initial Dispense Maximum Inaccuracy</base:Title>
            <base:Paragraphs>
              <base:Paragraph>The maximum inaccuracy of the initial dispense.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Value>3</data:Value>
        </data:Parameter>
        <data:Parameter Name="pMultiDispenseMaxInaccuracy" Type="Double" Unit="%">
          <data:Description>
            <base:Title>Multi dispense Maximum Inaccuracy</base:Title>
            <base:Paragraphs>
              <base:Paragraph>The maximum inaccuracy of the multi dispense.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Value>3.8</data:Value>
        </data:Parameter>
        <data:Parameter Name="pMultiDispenseMaxImprecision" Type="Double" Unit="%">
          <data:Description>
            <base:Title>Multi dispense Maximum Imprecision</base:Title>
            <base:Paragraphs>
              <base:Paragraph>The maximum imprecision of the multi dispense.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Value>1.2</data:Value>
        </data:Parameter>
        <data:Parameter Name="pMultiDispenseMaxInaccuracyLowVol" Type="Double" Unit="%">
          <data:Description>
            <base:Title>Multi dispense Low Volume Maximum Inaccuracy</base:Title>
            <base:Paragraphs>
              <base:Paragraph>The maximum inaccuracy of the aspiration dispense low volume.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Value>7.5</data:Value>
        </data:Parameter>
        <data:Parameter Name="pMultiDispenseMaxImprecisionLowVol" Type="Double" Unit="%">
          <data:Description>
            <base:Title>Multi dispense Low Volume Maximum Imprecision</base:Title>
            <base:Paragraphs>
              <base:Paragraph>The maximum imprecision of the multi dispense low volume.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Value>3.7</data:Value>
        </data:Parameter>
        <data:Parameter Name="pRequiredWashReagentVolume" Type="Double" Unit="m^3">
          <data:Description>
            <base:Title>Required Wash Reagent Volume</base:Title>
          </data:Description>
          <data:Value>170E-6</data:Value>
        </data:Parameter>
        <data:Parameter Name="pRequiredDiluentVolume" Type="Double" Unit="m^3">
          <data:Description>
            <base:Title>Required Liquid Waste Volume</base:Title>
          </data:Description>
          <data:Value>44E-6</data:Value>
        </data:Parameter>
        <data:Parameter Name="pRequiredLiquidWasteVolume" Type="Double" Unit="m^3">
          <data:Description>
            <base:Title>Required Liquid Waste Volume</base:Title>
          </data:Description>
          <data:Value>525E-6</data:Value>
        </data:Parameter>
      </data:ParameterList>
      <data:ResultList>
        <data:Result Name="rInitializationSuccessful" Type="Boolean">
          <data:Description>
            <base:Title>Initialization Success</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Initialization state.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Validation>
            <data:Condition Operator="EQ" Value="True" />
          </data:Validation>
        </data:Result>
        <data:Result Name="rBalanceSerial" Type="Serial">
          <data:Description>
            <base:Title>Balance Serial</base:Title>
            <base:Paragraphs>
              <base:Paragraph>The serialnumber (I4) of the Mettler Toledo Cube balance.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
        </data:Result>
        <data:Result Name="rBalanceVersion" Type="String">
          <data:Description>
            <base:Title>Balance Type</base:Title>
            <base:Paragraphs>
              <base:Paragraph>The version of the Mettler Toledo Cube balance.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
        </data:Result>
        <data:Result Name="rBalanceTemp" Type="String" Unit="°C">
          <data:Description>
            <base:Title>Balance Temperature</base:Title>
            <base:Paragraphs>
              <base:Paragraph>The temperature of the Mettler Toledo Cube balance.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
        </data:Result>
        <data:Result Name="rBalanceConnected" Type="Boolean">
          <data:Description>
            <base:Title>Balance Connected</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Balance connected</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
        </data:Result>
        <data:Result Name="rInitialDispenseVolumeInMicroLiter" Type="Double" Array="true" Size="5" Format="%.2n" Unit="ul">
          <data:Description>
            <base:Title>Initial Dispense Volume (Ul)</base:Title>
            <base:Paragraphs>
              <base:Paragraph>The amount that has been dispensed initially (ul)</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
        </data:Result>
        <data:Result Name="rInitialDispenseVolumeMicroLiterAverage" Type="Double" Format="%.2n" Unit="ul">
          <data:Description>
            <base:Title>Initial Dispense Average (Ul)</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Average for Initial Dispense (ul)</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
        </data:Result>
        <data:Result Name="rInitialDispenseVolumeInaccuracy" Type="Double" Unit="%" Format="%.2f">
          <data:Description>
            <base:Title>Initial Dispense Inaccuracy</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Inaccuracy for Initial Dispense</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Validation>
            <data:Condition Operator="LE" Parameter="pInitialDispenseMaxInaccuracy" />
          </data:Validation>
        </data:Result>
        <data:Result Name="rInitialDispenseVolumeMeasurement1Inaccuracy" Type="Double" Unit="%" Format="%.2f">
          <data:Description>
            <base:Title>Initial Dispense Inaccuracy for Measurement 1</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Inaccuracy for Initial Dispense</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Validation>
            <data:Condition Operator="LE" Parameter="pInitialDispenseMaxInaccuracy" />
          </data:Validation>
        </data:Result>
        <data:Result Name="rInitialDispenseVolumeMeasurement2Inaccuracy" Type="Double" Unit="%" Format="%.2f">
          <data:Description>
            <base:Title>Initial Dispense Inaccuracy for Measurement 2</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Inaccuracy for Initial Dispense</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Validation>
            <data:Condition Operator="LE" Parameter="pInitialDispenseMaxInaccuracy" />
          </data:Validation>
        </data:Result>
        <data:Result Name="rInitialDispenseVolumeMeasurement3Inaccuracy" Type="Double" Unit="%" Format="%.2f">
          <data:Description>
            <base:Title>Initial Dispense Inaccuracy for Measurement 3</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Inaccuracy for Initial Dispense</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Validation>
            <data:Condition Operator="LE" Parameter="pInitialDispenseMaxInaccuracy" />
          </data:Validation>
        </data:Result>
        <data:Result Name="rMultiDispenseVolumeMicroLiter" Type="Double" Array="true" Size="18" Format="%.2n" Unit="ul">
          <data:Description>
            <base:Title>Multi Dispense Volume (Ul)</base:Title>
            <base:Paragraphs>
              <base:Paragraph>The amount that has been Multidispensed. (ul)</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
        </data:Result>
        <data:Result Name="rMultiDispenseVolumeMicroLiterAverage" Type="Double" Format="%.2n" Unit="ul">
          <data:Description>
            <base:Title>Multi Dispense High Volume Average (Ul)</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Average for MultiDispense (ul)</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
        </data:Result>
        <data:Result Name="rMultiDispenseInaccuracy" Type="Double" Unit="%" Format="%.2f">
          <data:Description>
            <base:Title>Multi Dispense High Volume Inaccuracy</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Inaccuracy for MultiDispense Volumes</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Validation>
            <data:Condition Operator="LE" Parameter="pMultiDispenseMaxInaccuracy" />
          </data:Validation>
        </data:Result>
        <data:Result Name="rMultiDispenseImprecision" Type="Double" Unit="%" Format="%.2f">
          <data:Description>
            <base:Title>Multi Dispense High Volume Imprecision</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Imprecision for Multi Dispense Volumes</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Validation>
            <data:Condition Operator="LE" Parameter="pMultiDispenseMaxImprecision" />
          </data:Validation>
        </data:Result>
        <data:Result Name="rMultiDispenseVolumeMicroLiterLow" Type="Double" Array="true" Size="18" Format="%.2n" Unit="ul">
          <data:Description>
            <base:Title>Multi Dispense Low Volume (Ul)</base:Title>
            <base:Paragraphs>
              <base:Paragraph>The amount that has been Multidispensed. (ul)</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
        </data:Result>
        <data:Result Name="rMultiDispenseVolumeMicroLiterLowAverage" Type="Double" Format="%.2n" Unit="ul">
          <data:Description>
            <base:Title>Multi Dispense Low Volume Average (Ul)</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Average for MultiDispense Low (ul)</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
        </data:Result>
        <data:Result Name="rMultiDispenseInaccuracyLowVol" Type="Double" Unit="%" Format="%.2f">
