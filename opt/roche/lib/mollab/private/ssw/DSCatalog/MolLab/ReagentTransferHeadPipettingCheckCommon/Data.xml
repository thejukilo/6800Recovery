            <base:Title>Multi Dispense Low Volume Inaccuracy</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Inaccuracy for MultiDispense Volumes</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Validation>
            <data:Condition Operator="LE" Parameter="pMultiDispenseMaxInaccuracyLowVol" />
          </data:Validation>
        </data:Result>
        <data:Result Name="rMultiDispenseImprecisionLowVol" Type="Double" Unit="%" Format="%.2f">
          <data:Description>
            <base:Title>Multi Dispense Low Volume Imprecision</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Imprecision for Multi Dispense Volumes</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Validation>
            <data:Condition Operator="LE" Parameter="pMultiDispenseMaxImprecisionLowVol" />
          </data:Validation>
        </data:Result>
