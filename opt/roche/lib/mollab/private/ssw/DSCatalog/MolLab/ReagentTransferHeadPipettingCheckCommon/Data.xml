<?xml version="1.0" encoding="utf-8"?>
<ds:TestList Hash="3FA38F396B3EF2B819223FE4BF090BDFDD53E229CFE0" xmlns:ds="urn:ds" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:base="urn:base" xmlns:data="urn:data" xsi:schemaLocation="urn:ds ../../../Tools/Schemas/LabCore.Diagnose/dsData.xsd">
  <ds:TestFunction Name="ReagentTransferHeadPipettingCheckCommon">
    <base:Content>
      <base:File Type="Data" Version="1.0.0.0000" />
    </base:Content>
    <ds:Data>
      <data:ParameterList>
        <data:Parameter Name="pModuleId" Type="String">
          <data:Description>
            <base:Title>Name of the involved processing module</base:Title>
          </data:Description>
        </data:Parameter>
        <data:Parameter Name="pBalanceIPAddress" Type="String">
          <data:Description>
            <base:Title>Balance IP</base:Title>
            <base:Paragraphs>
              <base:Paragraph>The IPAddress of the Mettler Toledo Cube balance.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Value>192.168.95.248</data:Value>
        </data:Parameter>
        <data:Parameter Name="pBalanceIPPort" Type="Integer">
          <data:Description>
            <base:Title>TCP Port Adress of the balance</base:Title>
          </data:Description>
          <data:Value>8001</data:Value>
        </data:Parameter>
        <data:Parameter Name="pWaitTimeForBalance" Type="Double" Unit="sec" Format="%.2n">
          <data:Description>
            <base:Title>Balance wait Time</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Wait Time for the balance</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Value>4</data:Value>
        </data:Parameter>
        <data:Parameter Name="pWaitTimeBetweenMedianValues" Type="Double" Unit="sec" Format="%.2n">
          <data:Description>
            <base:Title>Balance wait Time</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Wait Time for the balance</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Value>0</data:Value>
        </data:Parameter>
        <data:Parameter Name="pValueCountForMedianWeight" Type="Integer">
          <data:Description>
            <base:Title>Value count for median weight</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Count of measurements to build the median weight value</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Value>11</data:Value>
        </data:Parameter>
        <data:Parameter Name="pUsedNetWeightCommand" Type="String">
          <data:Description>
            <base:Title>Used NetWeight Command</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Used NetWeight Command</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Value>SI</data:Value>
        </data:Parameter>
        <data:Parameter Name="pPipIndex" Type="String">
          <data:Description>
            <base:Title>Index of the involved reagent Pipettor (A-H)</base:Title>
          </data:Description>
        </data:Parameter>
        <data:Parameter Name="pPipettingParameter800" Type="String">
          <data:Description>
            <base:Title>Pipetting parameter SSW 800</base:Title>
            <base:Paragraphs>
              <base:Paragraph>The pipetting parameter to use.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Value>8893befa-0be7-4846-95c5-8c2c7bf6b6f1</data:Value>
        </data:Parameter>
        <data:Parameter Name="pPipettingParameter50" Type="String">
          <data:Description>
            <base:Title>Pipetting parameter for SSW 50</base:Title>
            <base:Paragraphs>
              <base:Paragraph>The pipetting parameter to use.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Value>a8b643e9-c14e-4b4f-bdd2-70ca56f96293</data:Value>
        </data:Parameter>
        <data:Parameter Name="pPipettingParameter10" Type="String">
          <data:Description>
            <base:Title>Pipetting parameter for SSW 10</base:Title>
            <base:Paragraphs>
              <base:Paragraph>The pipetting parameter to use.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Value>0a593c1a-122d-4b8e-ad91-1265bc694768</data:Value>
        </data:Parameter>
        <data:Parameter Name="pInitialDispenseRepetitions" Type="Integer">
          <data:Description>
            <base:Title>Initial dispense repetitions</base:Title>
          </data:Description>
          <data:Value>3</data:Value>
        </data:Parameter>
        <data:Parameter Name="pInitialDispenseVolumeInCubicMeters" Type="Double" Unit="m^3">
          <data:Description>
            <base:Title>Initial Pipettingvolume m3</base:Title>
            <base:Paragraphs>
              <base:Paragraph>The Volume that has to be dispensed into the balance vessel.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Value>8E-07</data:Value>
        </data:Parameter>
        <data:Parameter Name="pMultiDispenseOuterRepetitions" Type="Integer">
          <data:Description>
            <base:Title>Multi dispense outer repetitions</base:Title>
            <base:Paragraphs>
              <base:Paragraph>MultiDispenseOuterRepetitions</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Value>2</data:Value>
        </data:Parameter>
        <data:Parameter Name="pMultiDispenseOuterRepetitionsLow" Type="Integer">
          <data:Description>
            <base:Title>Multi dispense outer repetitions</base:Title>
            <base:Paragraphs>
              <base:Paragraph>MultiDispenseOuterRepetitions</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Value>2</data:Value>
        </data:Parameter>
        <data:Parameter Name="pMultiDispenseInnerRepetitions" Type="Integer">
          <data:Description>
            <base:Title>Multi dispense inner repetitions</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Multi dispense inner repetitions</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Value>6</data:Value>
        </data:Parameter>
        <data:Parameter Name="pMultiDispenseInnerRepetitionsLowVolume" Type="Integer">
          <data:Description>
            <base:Title>Multi dispense inner repetitions</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Multi dispense inner repetitions</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Value>6</data:Value>
        </data:Parameter>
        <data:Parameter Name="pMultiDispenseVolumeInCubicMeters" Type="Double" Unit="m^3">
          <data:Description>
            <base:Title>Multi dispense volume (m3)</base:Title>
            <base:Paragraphs>
              <base:Paragraph>The MultiDispenseVolume that shall be aspirated and dispensed.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Value>50E-09</data:Value>
        </data:Parameter>
        <data:Parameter Name="pMultiDispenseLowVolumeInCubicMeters" Type="Double" Unit="m^3">
          <data:Description>
            <base:Title>Multi dispense volume (m3)</base:Title>
            <base:Paragraphs>
              <base:Paragraph>The MultiDispenseVolume that shall be aspirated and dispensed for LowVolume.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Value>10E-09</data:Value>
        </data:Parameter>
        <data:Parameter Name="pAspirationDispenseRepetitions" Type="Integer">
          <data:Description>
            <base:Title>Number of Repetitions</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Number of Aspriations and Dispensions.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Value>16</data:Value>
        </data:Parameter>
        <data:Parameter Name="pAspirationDispenseVolumeInCubicMeters" Type="Double" Unit="m^3">
          <data:Description>
            <base:Title>LowVolume (m3)</base:Title>
            <base:Paragraphs>
              <base:Paragraph>The low Volume that shall be aspirated and dispensed.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Value>10E-09</data:Value>
        </data:Parameter>
        <data:Parameter Name="pAspirationOverdrawInCubicMeters" Type="Double" Unit="m^3">
          <data:Description>
            <base:Title>Aspiration Overdraw</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Aspiration Overdraw according to pipfile</base:Paragraph>
            </base:Paragraphs>
