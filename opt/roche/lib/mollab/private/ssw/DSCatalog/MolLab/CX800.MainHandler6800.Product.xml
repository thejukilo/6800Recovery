  <ds:TestFunction Name="MainHandlerHandlingCheck6800">
    <!-- Auto-Generated text from description file. -->
    <product:Description>
      <base:Title>Main handler handling check 6800</base:Title>
      <base:Paragraphs>
        <base:Paragraph>It checks that the main handler can move all consumables and cassettes to the different transfer positions.</base:Paragraph>
        <base:Paragraph>-----------------------------------------------------------------------------------------------</base:Paragraph>
        <base:Paragraph>Preconditions:</base:Paragraph>
        <base:Paragraph>- The instrument is in interlock service mode</base:Paragraph>
        <base:Paragraph>- If a clean-up was performed and a consumable or cassette was placed into the transfer module, you have to remove it before executing this check</base:Paragraph>
        <base:Paragraph>- The front covers of the transfer module and processing modules are opened</base:Paragraph>
        <base:Paragraph>- No empty amplification plate cassettes loaded</base:Paragraph>
        <base:Paragraph>- Transfer positions of transfer and processing module are empty</base:Paragraph>
        <base:Paragraph>-----------------------------------------------------------------------------------------------</base:Paragraph>
        <base:Paragraph>Required Time: 24 minutes</base:Paragraph>
        <base:Paragraph>-----------------------------------------------------------------------------------------------</base:Paragraph>
        <base:Paragraph>Required Equipment:                      </base:Paragraph>
        <base:Paragraph>- 2 cobas omni amplification plate Casettes (each with 4 plates inside)</base:Paragraph>
        <base:Paragraph>- 2 cobas omni Pipette tips</base:Paragraph>
        <base:Paragraph>- 2 cobas omni processing plates</base:Paragraph>
        <base:Paragraph>- 1 cobas omni MGP reagent cassette</base:Paragraph>
        <base:Paragraph>- 1 reagent cassettes (e.g. cobas omni Training Kit)</base:Paragraph>
        <base:Paragraph>- 1 control cassette (e.g. cobas omni Training control Kit)</base:Paragraph>
        <base:Paragraph>-----------------------------------------------------------------------------------------------</base:Paragraph>
        <base:Paragraph>NOTE: The check begins immediately after clicking the start button. Mind the moving units!</base:Paragraph>
        <base:Paragraph>WARNING: The RFID of the reagent cassette is modified and will cause reagent cassette invalidation.</base:Paragraph>
      </base:Paragraphs>
    </product:Description>
    <test:Files>
      <test:Workflow Version="1.0.0.0000" />
      <test:Data Version="1.0.0.0000" />
      <test:Assembly Version="1.0.0.0000" />
    </test:Files>
  </ds:TestFunction>
