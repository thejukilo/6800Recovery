            <data:Condition Operator="EQ" Value="True" />
          </data:Validation>
        </data:Result>
        <data:Result Name="rLiquidWaste3SensorDetectedContainerFull" Type="Boolean">
          <data:Description>
            <base:Title>Liquid Waste 3 Sensor Detection Of Container Full</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Detection of container being full of liquid.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Validation>
            <data:Condition Operator="EQ" Value="True" />
          </data:Validation>
        </data:Result>
        <data:Result Name="rLiquidWaste3SensorDetectedContainerEmpty" Type="Boolean">
          <data:Description>
            <base:Title>Liquid Waste 3 Sensor Detection Of Container Empty</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Detection of container being empty.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Validation>
            <data:Condition Operator="EQ" Value="True" />
          </data:Validation>
        </data:Result>
        <data:Result Name="rLiquidWaste3SensorDetectedContainerPresence" Type="Boolean">
          <data:Description>
            <base:Title>Liquid Waste 3 Sensor Detection Container Presence</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Detection of container presence by the sensor.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Validation>
            <data:Condition Operator="EQ" Value="True" />
          </data:Validation>
        </data:Result>
        <!-- Post Loop Results -->
        <data:Result Name="rLiquidWasteDrawerClosedAndLocked" Type="Boolean">
          <data:Description>
            <base:Title>Drawer Closure And Lock Detection</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Drawer closure and lock detection at the end of the check.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Validation>
            <data:Condition Operator="EQ" Value="True" />
          </data:Validation>
        </data:Result>
        <data:Result Name="rSensorCheckingLiquidWasteDrawerClosedAndLocked" Type="Boolean">
          <data:Description>
            <base:Title>Sensor Checking Drawer Closure And Lock</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Sensor readback of drawer closure and lock.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Validation>
            <data:Condition Operator="EQ" Value="True" />
          </data:Validation>
        </data:Result>
      </data:ResultList>
    </ds:Data>
  </ds:TestFunction>
</ds:TestList>