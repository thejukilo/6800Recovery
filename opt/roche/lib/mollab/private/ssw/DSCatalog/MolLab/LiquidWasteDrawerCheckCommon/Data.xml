          <data:Validation>
            <data:Condition Operator="EQ" Value="True" />
          </data:Validation>
        </data:Result>
        <data:Result Name="rLiquidWaste2LedTransitionToGreen" Type="Boolean">
          <data:Description>
            <base:Title>Liquid Waste 2 LED Transition To Green</base:Title>
            <base:Paragraphs>
              <base:Paragraph>User confirmation of LED transitioning off and then to green.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Validation>
            <data:Condition Operator="EQ" Value="True" />
          </data:Validation>
        </data:Result>
        <data:Result Name="rLiquidWaste2SensorDetectedContainerAbsence" Type="Boolean">
          <data:Description>
            <base:Title>Liquid Waste 2 Sensor Detection Container Absence</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Detection of container absence by the sensor.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Validation>
            <data:Condition Operator="EQ" Value="True" />
          </data:Validation>
        </data:Result>
        <data:Result Name="rLiquidWaste2SensorDetectedContainerFull" Type="Boolean">
          <data:Description>
            <base:Title>Liquid Waste 2 Sensor Detection Of Container Full</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Detection of container being full of liquid.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Validation>
            <data:Condition Operator="EQ" Value="True" />
          </data:Validation>
        </data:Result>
        <data:Result Name="rLiquidWaste2SensorDetectedContainerEmpty" Type="Boolean">
          <data:Description>
            <base:Title>Liquid Waste 2 Sensor Detection Of Container Empty</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Detection of container being empty.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Validation>
            <data:Condition Operator="EQ" Value="True" />
          </data:Validation>
        </data:Result>
        <data:Result Name="rLiquidWaste2SensorDetectedContainerPresence" Type="Boolean">
          <data:Description>
            <base:Title>Liquid Waste 2 Sensor Detection Container Presence</base:Title>
            <base:Paragraphs>
              <base:Paragraph>Detection of container presence by the sensor.</base:Paragraph>
            </base:Paragraphs>
          </data:Description>
          <data:Validation>
            <data:Condition Operator="EQ" Value="True" />
          </data:Validation>
        </data:Result>
        <!-- Liquid Waste 3 Container Results -->
        <data:Result Name="rLiquidWaste3VerifyDispenseCapClosed" Type="Boolean">
          <data:Description>
