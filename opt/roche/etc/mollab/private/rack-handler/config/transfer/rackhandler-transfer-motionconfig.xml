  <InitSequence SequenceID="0">
    <InitPattern RelatedMotorName="MotorX">
      <PoolCheck PoolType="ParameterPool" ItemType="int32">
        <PoolID>130</PoolID>
        <PoolCompareConfig MinValue="1" MaxValue="10000">
          <!-- Consumable on Gripper -->
          <SequenceConfigID>2</SequenceConfigID>
        </PoolCompareConfig>
        <DefaultSequenceConfigID>1</DefaultSequenceConfigID>
      </PoolCheck>
    </InitPattern>
  </InitSequence>
  <!--Check if Rack is present-->
