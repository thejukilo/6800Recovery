<?xml version="1.0" encoding="UTF-8"?>
<SMSConfig xsi:noNamespaceSchemaLocation="/opt/roche/config/xsd/SMStageConfig.xsd"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <SMStage>
    <StepperMotor OutputPortID="SMC_0" Name="EjectorMotor">
      <CreatePort>
        <OutputPortType>SMC</OutputPortType>
        <SensorID1>Init</SensorID1>
        <SensorID2>NotUsed</SensorID2>
        <SensorID3>NotUsed</SensorID3>
        <SensorID4>NotUsed</SensorID4>
      </CreatePort>
      <Configure>
        <RotationDirection>Inverting</RotationDirection>
        <InitSensor>Enable</InitSensor>
        <InitDirection>Backward</InitDirection>
        <InitSensorLogic>Rising_Edge</InitSensorLogic>
        <AutomaticalBackwardInit>Enable</AutomaticalBackwardInit>
        <RotationMonitoringSensor>Disable</RotationMonitoringSensor>
        <RotationMonitoringSteps>100</RotationMonitoringSteps>
        <CircuitLoadSetting>
          <CircuitLoadDetection>Enable</CircuitLoadDetection>
          <CircuitLoadMinimum>1</CircuitLoadMinimum>
          <CircuitLoadMaximum>100</CircuitLoadMaximum>
        </CircuitLoadSetting>
        <CurrentSetting>
          <MaximalCurrent>1200</MaximalCurrent>
          <CurrentReductionEnable>Enable</CurrentReductionEnable>
          <CurrentReductionValue>10</CurrentReductionValue>
          <CurrentReductionTime>200</CurrentReductionTime>
        </CurrentSetting>
        <InitPosition>0</InitPosition>
        <MoveToInitPositionEnable>Disable</MoveToInitPositionEnable>
        <MoveToInitPositionDelay>0</MoveToInitPositionDelay>
        <MaximumPosition>7900</MaximumPosition>
        <MinimumPosition>-100</MinimumPosition>
        <StepType>Quart_Step</StepType>
        <AccelerationMode>Linear</AccelerationMode>
      </Configure>
      <Speeds InitSpeedID="0" DefaultMoveSpeedID="1">
        <Speed SpeedID="0">
          <Speed>5000</Speed>
          <StartSpeed>500</StartSpeed>
          <Acceleration>50000</Acceleration>
          <Deceleration>50000</Deceleration>
        </Speed>
        <Speed SpeedID="1">
          <Speed>5000</Speed>
          <StartSpeed>500</StartSpeed>
          <Acceleration>50000</Acceleration>
          <Deceleration>50000</Deceleration>
        </Speed>
      </Speeds>
    </StepperMotor>
    <DigitalInputPorts>
      <DigitalInputPort Name="Init">
        <InputPortID>0</InputPortID>
        <SignalPolarity>HighActive</SignalPolarity>
      </DigitalInputPort>
      <DigitalInputPort Name="DrawerSensor">
        <InputPortID>1</InputPortID>
        <SignalPolarity>HighActive</SignalPolarity>
        <EventSource>
          <SignalEdge>Both_Edges</SignalEdge>
          <SamplingTime>4</SamplingTime>
          <EventMode>Recurring</EventMode>
          <SuspendTime>0</SuspendTime>
          <DebouncingTime>50</DebouncingTime>
        </EventSource>
      </DigitalInputPort>
      <DigitalInputPort Name="Position1Sensor">
        <InputPortID>2</InputPortID>
        <SignalPolarity>HighActive</SignalPolarity>
      </DigitalInputPort>
      <DigitalInputPort Name="Position2Sensor">
        <InputPortID>3</InputPortID>
        <SignalPolarity>HighActive</SignalPolarity>
      </DigitalInputPort>
    </DigitalInputPorts>
  </SMStage>
</SMSConfig>