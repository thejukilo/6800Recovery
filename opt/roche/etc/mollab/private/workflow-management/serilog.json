{
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "shared-data/logs/WorkflowManagement_.log",
          "outputTemplate": "[{UtcTimestamp:O}][WFM][{Level:u1}][{Logger}][{ThreadId}]{Message:lj}{Exception}[EOL]{NewLine}",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "rollOnFileSizeLimit": false,
          "fileSizeLimitBytes": 314572800
        }
      }
    ],
    "Enrich": [ "WithThreadId", "WithUtcTimestamp" ],
    "ExcludedNamePrefixes": [ "Roche.NewGen.WorkflowManagement.", "Roche.CX800.", "Roche.MolLab." ]
  }
}
