<?xml version="1.0" encoding="UTF-8"?>
<ECPSWConfiguration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="/opt/roche/config/ECPSWConfiguration.xsd">

  <ConnectedCSMs>
    <ConnectedCSM FileName="newgen-consumablepark" EnableExecPrefix="false" StackSize_kbytes="256">
      <CSMConfigureParameters>
        <System RealtimePriority="45" MiddlewarePriority="76" CPUAffinity="-1" TraceLevel="4" Verbose="false" />
        <CSMSpecific ModuleID="620" ProviderSocket="/opt/CSM_620.sock">
          <CDIDefinition SwitchName="RFIDReadingStationMotor-cdi" DeviceName="SC_PlateHandler_2_RFIDReadingStationMotor" />
          <CDIDefinition SwitchName="PPlate48ParkAMotor-cdi" DeviceName="SC_PlateHandler_2_PPlate48ParkAMotor" />
          <CDIDefinition SwitchName="PPlate48ParkBMotor-cdi" DeviceName="SC_PlateHandler_2_PPlate48ParkBMotor" />
          <CDIDefinition SwitchName="ProcessPark1-cdi" DeviceName="SC_ProcessPark_Downholder1" />
          <CDIDefinition SwitchName="ProcessPark2-cdi" DeviceName="SC_ProcessPark_Downholder2" />
          <CSMDefinition ConnectedModuleID="613" CSMName="RFIDReader-id" ConnectToSocket="/opt/CSM_613.sock" />
          <CSMDefinition ConnectedModuleID="998" CSMName="MAM_HDI-id" />
          <XMLConfigurationFile XMLFileName="${UNITCONFIGPATH}/settings/config/newgen-consumablepark-motionconfig.xml" />
          <XMLConfigurationFile SwitchName="--rfid_label_definition_path" XMLFileName="${UNITCONFIGPATH}/rfid-x800-var/DataConcept.xml" />
          <CommandLineSwitch SwitchName="--telemetry_url" Value="otel:4318/v1/traces" />
          <CommandLineSwitch SwitchName="--use-rabbitmq" />
          <CommandLineSwitch SwitchName="--rabbitmq-address" Value="amqp://roche:$roche_2023!@rabbitmq-server:5672" />
          <CommandLineSwitch SwitchName="--rabbitmq-command-exchange" Value="roche.requests.dx" />
          <CommandLineSwitch SwitchName="--rabbitmq-command-queue" Value="roche.newgen.consumablepark.q" />
          <CommandLineSwitch SwitchName="--rabbitmq-event-exchange" Value="roche.events.tx" />
          <CommandLineSwitch SwitchName="--rabbitmq-event-queue" Value="roche.newgen.consumablepark.q" />
          <CommandLineSwitch SwitchName="--rabbitmq-request-exchange" Value="" />
          <CommandLineSwitch SwitchName="--rabbitmq-request-queue" Value="roche.newgen.consumablepark.q" />
          <CommandLineSwitch SwitchName="--rabbitmq-response-exchange" Value="" />
          <CommandLineSwitch SwitchName="--rabbitmq-response-queue" Value="roche.newgen.consumablepark.q" />
          <CommandLineSwitch SwitchName="--RFIDReader-socket" Value="/opt/CSM_613.sock" />
          <CommandLineSwitch SwitchName="--disable-report-forwarding" />
          <CommandLineSwitch SwitchName="--ecc" Value="${UNITCONFIGPATH}/settings/startup/ecc.xml" />
        </CSMSpecific>
      </CSMConfigureParameters>
      <ConnectedCSMs>
        <ConnectedCSM FileName="rfidreader" StackSize_kbytes="128">
          <CSMConfigureParameters>
            <System RealtimePriority="46" MiddlewarePriority="76" CPUAffinity="-1" TraceLevel="4" Verbose="false" />
            <CSMSpecific ModuleID="613" ProviderSocket="/opt/CSM_613.sock">
              <CDIDefinition SwitchName="RFIDReader-cdi" DeviceName="SC_ConsumablePark_RHC_RFIDReader" />
              <XMLConfigurationFile SwitchName="--rfid_label_definition_path" XMLFileName="${UNITCONFIGPATH}/rfid-x800-var/DataConcept.xml" />
              <CommandLineSwitch SwitchName="--security_definition_path" Value="${UNITCONFIGPATH}/rfid-x800-var/SecurityDefinitions.sec" />
              <CommandLineSwitch SwitchName="--key_library_path" Value="${UNITCONFIGPATH}/rfid-x800-var/KeyLibrary.sec" />
              <CommandLineSwitch SwitchName="--serial_port_id" Value="0" />
              <CommandLineSwitch SwitchName="--enableParserLog" Value="0" />
            </CSMSpecific>
          </CSMConfigureParameters>
        </ConnectedCSM>
      </ConnectedCSMs>
    </ConnectedCSM>
  </ConnectedCSMs>
</ECPSWConfiguration>