<?xml version="1.0" encoding="UTF-8"?>
<ECPSWConfiguration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="/opt/roche/config/ECPSWConfiguration.xsd">
  <ConnectedCSMs>
    <!-- InterimReagentStorage module A -->
    <ConnectedCSM FileName="newgen-interimreagentstorage">
      <CSMConfigureParameters>
        <System RealtimePriority="45" MiddlewarePriority="81" TraceLevel="4" Verbose="false" />
        <CSMSpecific ModuleID="332" ProviderSocket="/opt/CSM_332.sock">
          <CDIDefinition SwitchName="RHCTemperatureControl-cdi" DeviceName="PCA_InterimReagentStorage_RHC_Cooler" />
          <CDIDefinition SwitchName="MotionSensors-cdi" DeviceName="PCA_InterimReagentStorage_MC_Sensors" />
          <CSMDefinition ConnectedModuleID="335" CSMName="RFIDReader-id" ConnectToSocket="/opt/CSM_335.sock" />
          <CSMDefinition ConnectedModuleID="333" CSMName="Transfer-id" ConnectToSocket="/opt/CSM_333.sock" />
          <CSMDefinition ConnectedModuleID="998" CSMName="MAM_HDI-id" />
          <XMLConfigurationFile SwitchName="--RHCConfig" XMLFileName="${UNITCONFIGPATH}/settings/config/newgen-interimreagentstorage-rhcconfig.xml" />
          <XMLConfigurationFile SwitchName="--parameter_pool_configuration_path" XMLFileName="${UNITCONFIGPATH}/settings/config/newgen-interimreagentstorage-parampool.xml" />
          <XMLConfigurationFile SwitchName="--rfid_label_definition_path" XMLFileName="${UNITCONFIGPATH}/rfid-x800-var/DataConcept.xml" />
          <XMLConfigurationFile SwitchName="--MotionConfig" XMLFileName="${UNITCONFIGPATH}/settings/config/newgen-interimreagentstorage-motionconfig.xml" />
          <CommandLineSwitch SwitchName="--RFIDReader-socket" Value="/opt/CSM_335.sock" />
          <CommandLineSwitch SwitchName="--Transfer-socket" Value="/opt/CSM_333.sock" />
          <CommandLineSwitch SwitchName="--ModuleId" Value="A" />
          <CommandLineSwitch SwitchName="--telemetry_url" Value="otel:4318/v1/traces" />
          <CommandLineSwitch SwitchName="--use-rabbitmq" />
          <CommandLineSwitch SwitchName="--rabbitmq-address" Value="amqp://roche:$roche_2023!@rabbitmq-server:5672" />
          <CommandLineSwitch SwitchName="--rabbitmq-command-exchange" Value="roche.requests.dx" />
          <CommandLineSwitch SwitchName="--rabbitmq-command-queue" Value="roche.newgen.interimreagentstorage.a.q" />
          <CommandLineSwitch SwitchName="--rabbitmq-event-exchange" Value="roche.events.tx" />
          <CommandLineSwitch SwitchName="--rabbitmq-event-queue" Value="roche.newgen.interimreagentstorage.a.q" />
          <CommandLineSwitch SwitchName="--rabbitmq-request-exchange" Value="" />
          <CommandLineSwitch SwitchName="--rabbitmq-request-queue" Value="roche.newgen.interimreagentstorage.a.q" />
          <CommandLineSwitch SwitchName="--rabbitmq-response-exchange" Value="" />
          <CommandLineSwitch SwitchName="--rabbitmq-response-queue" Value="roche.newgen.interimreagentstorage.a.q" />
          <CommandLineSwitch SwitchName="--disable-report-forwarding" />
          <CommandLineSwitch SwitchName="--ecc" Value="${UNITCONFIGPATH}/settings/startup/ecc.xml" />
        </CSMSpecific>
      </CSMConfigureParameters>
      <ConnectedCSMs>
        <!-- RFIDReader -->
        <ConnectedCSM FileName="rfidreader">
          <CSMConfigureParameters>
            <System RealtimePriority="45" MiddlewarePriority="81" TraceLevel="4" Verbose="false" />
            <CSMSpecific ModuleID="335" ProviderSocket="/opt/CSM_335.sock">
              <CDIDefinition SwitchName="RFIDReader-cdi" DeviceName="PCA_InterimReagentStorage_RHC_RFIDReader" />
              <XMLConfigurationFile SwitchName="--rfid_label_definition_path" XMLFileName="${UNITCONFIGPATH}/rfid-x800-var/DataConcept.xml" />
              <XMLConfigurationFile SwitchName="--security_definition_path" XMLFileName="${UNITCONFIGPATH}/rfid-x800-var/SecurityDefinitions.sec" />
              <XMLConfigurationFile SwitchName="--key_library_path" XMLFileName="${UNITCONFIGPATH}/rfid-x800-var/KeyLibrary.sec" />
              <CommandLineSwitch SwitchName="--serial_port_id" Value="0" />
              <CommandLineSwitch SwitchName="--port_mode" Value="1" />
              <CommandLineSwitch SwitchName="--enableParserLog" Value="1" />
            </CSMSpecific>
          </CSMConfigureParameters>
        </ConnectedCSM>
        <!-- TransferXYZGripper -->
        <ConnectedCSM FileName="transfer-xyz-gripper">
          <CSMConfigureParameters>
            <System RealtimePriority="72" MiddlewarePriority="77" TraceLevel="4" Verbose="false" />
            <CSMSpecific ModuleID="333" ProviderSocket="/opt/CSM_333.sock">
              <CDIDefinition SwitchName="MotorX-cdi" DeviceName="PCA_InterimReagentStorage_MC_MotorX" />
              <CDIDefinition SwitchName="MotorY-cdi" DeviceName="PCA_InterimReagentStorage_MC_MotorY" />
              <CDIDefinition SwitchName="MotorZ-cdi" DeviceName="PCA_InterimReagentStorage_MC_MotorZ" />
              <CSMDefinition ConnectedModuleID="998" CSMName="MAM_HDI-id" />
              <XMLConfigurationFile XMLFileName="${UNITCONFIGPATH}/settings/config/newgen-interimreagentstorage-transferxyzgripper-config.xml" />
              <XMLConfigurationFile SwitchName="--MotionConfig" XMLFileName="${UNITCONFIGPATH}/settings/config/newgen-interimreagentstorage-transferxyzgripper-motionconfig.xml" />
              <!--_CAF-->
              <XMLConfigurationFile SwitchName="--Positioning" XMLFileName="${UNITCONFIGPATH}/settings/config/newgen-interimreagentstorage-positioning.xml" />
              <!--_CAF-->
              <XMLConfigurationFile SwitchName="--ReferencePointOffset" XMLFileName="${ICSHAREPATH}/teaching-data/interimreagentstorage-a-reference-point-offset.xml" />
              <XMLConfigurationFile SwitchName="--RoutingConfig" XMLFileName="${UNITCONFIGPATH}/settings/config/newgen-interimreagentstorage-transferxyzgripper-exclusionareas.xml" />
              <!--_CAF-->
              <XMLConfigurationFile SwitchName="--HeadInfo" XMLFileName="${UNITCONFIGPATH}/settings/config/newgen-interimreagentstorage-transferxyzgripper-headinfo.xml" />
              <CommandLineSwitch SwitchName="--CycleTime" Value="0" />
            </CSMSpecific>
          </CSMConfigureParameters>
        </ConnectedCSM>
      </ConnectedCSMs>
    </ConnectedCSM>
  </ConnectedCSMs>
</ECPSWConfiguration>