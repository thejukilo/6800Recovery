    <DebouncingTime>0.1</DebouncingTime>
    <SuspendTime>0.0</SuspendTime>
  </SingleBitInput>
  
  <SingleBitInput PortName="CassettePresentRising">
    <TypeOfInput>Slow</TypeOfInput>
    <PhysicalInputNumber>1</PhysicalInputNumber>
    <SignalInverting>NotInverted</SignalInverting>
    <ActiveEdge>Rising</ActiveEdge>
    <DebouncingEdge>Both</DebouncingEdge>
    <DebouncingTime>0.1</DebouncingTime>
    <SuspendTime>0.0</SuspendTime>
  </SingleBitInput>
 </NoMotor>
</MotionConfig>