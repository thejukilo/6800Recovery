<?xml version="1.0" encoding="UTF-8"?>
<MotionConfig xsi:noNamespaceSchemaLocation="MotionConfig.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
 <NoMotor NoMotorName="MotionSensors" DeviceId="1">
