{
  "messaging.rabbitmq": {
    "name": "DC",
    "hostName": "rabbitmq-server",
    "distributionChannels": [
      {
        "name": "Distribution",
        "queueName": "roche.mollab.datacollection.q",
        "logMissingSubscriptions": false
      }
    ],
    "publicationChannels": [
      {
        "name": "Publication"
      }
    ]
  },

  "performanceMonitoring": {
    "eventCounters": {
      "enabled": true
    }
  },

  "DockerContainerStats": {
    "Enabled": true,
    "Interval": "00:01:00",
    "RequestTimeout": "00:00:10",
    "DockerSocketPath": "/var/run/docker.sock",
    "ExcludeContainerNames": []
  },

  "ManufacturingData": {
    "Path": "shared-config/manufacturing-data.json"
  },

  "EventStream": {
    "RootDirectory": "shared-data/eventstream",
    "DataUploadTempDirectory": "data/tmp/eventstream/data-upload",
    "MaxNumberOfLogs": 7,
    "MaxEventStreamLogfileSizeInMegaByte": 5000,
    "ExcludedMessageIds": [],
    "PseudonymizeData": true,
    "PseudonymizedMessageIds": [
      "Roche.MolLab.UiApi.UserLoggedIn",
      "Roche.MolLab.UiApi.UserLoggedOut",
      "Roche.c68_8800.DataManagerGateway.FromDM.NoWorkOrderForSampleFound",
      "Roche.c68_8800.UiApi.AuditableEventOccurred",
      "Roche.c68_8800.RackHandler.RackScanned",
      "Roche.c68_8800.TransferModule.SampleRackLoaded",
      "Roche.c68_8800.TransferModule.SampleRackUnloaded",
      "Roche.c68_8800.TransferModule.RackPositionContentChanged",
      "Roche.c68_8800.WorkOrderManagement.SampleWorkOrderAccepted",
      "Roche.c68_8800.WorkOrderManagement.AssignSampleWorkOrder",
      "Roche.c68_8800.WorkflowManagement.RunExecutionStarted"
    ]
  },

  "ProblemReport": {
    "SystemNameTokens": {
      "6800": "c6800",
      "8800": "c8800"
    },
    "WorkingDirectory": "data/tmp/problem-reports/working-directory",
    "SummaryFileName": "ProblemReportSummary.xml",
    "ErrorLogfileName": "ProblemReportErrorLog.txt",
    "ZipPassword": "comit",
    "SystemReportDataCollector": {
      "IncludeSystemReport": true,
      "SourcePath": "shared-data/system-reports",
      "DestinationPath": "system-report",
      "SystemReportConfiguration": {
        "IncludeFileList": false,
        "IncludeRlxSystemReport": true,
        "NumberOfRlxSystemReports": 1,
        "IncludeApplicationLogs": false,
        "NumberOfSystemLogDays": 0,
        "IncludeRlxIntegrityCheck": true
      }
    },
    "TracingDataCollector": {
      "IncludeTraces": true,
      "Address": "http://otel:16685",
      "DestinationPath": "traces",
      "UseNumberOfDaysOfDataToCollectFromCommand": true
    },
    "ProblemReportTypes": [
      {
        "Type": "NonSensitiveData",
        "DestinationFolder": "data/tmp/problem-reports/data-upload",
        "Prefix": "UPR"
      },
      {
        "Type": "AllData",
        "DestinationFolder": "shared-data/problem-reports",
        "Prefix": "PR"
      }
    ],
    "FileSystemDataCollectors": [
      {
        "Id": "ServiceImages",
        "SourcePath": "shared-data/service-images",
        "DestinationPath": "service-images",
        "ContainsSensitiveData": false,
        "IsRequired": false
      },
      {
        "Id": "ServiceSoftwareChecksReports",
        "SourcePath": "shared-data/service-software-checks-reports",
        "DestinationPath": "service-software-checks-reports",
        "ContainsSensitiveData": false,
        "IsRequired": false
      },
      {
        "Id": "PipettingParameterSets_SampleHead",
        "SourcePath": "shared-data/tmp/pipetting-parameter-sets/sample-transfer",
        "DestinationPath": "pipetting-parameter-sets/sample-head",
        "ContainsSensitiveData": false
      },
      {
        "Id": "PipettingParameterSets_ReagentHeadA",
        "SourcePath": "shared-data/tmp/pipetting-parameter-sets/reagent-transfer-a",
        "DestinationPath": "pipetting-parameter-sets/reagent-head/a",
        "ContainsSensitiveData": false
      },
      {
        "Id": "PipettingParameterSets_ReagentHeadB",
        "SourcePath": "shared-data/tmp/pipetting-parameter-sets/reagent-transfer-b",
        "DestinationPath": "pipetting-parameter-sets/reagent-head/b",
        "ContainsSensitiveData": false,
        "InstrumentType": "8800"
      },
      {
        "Id": "PipettingParameterSets_ProcessHeadA",
        "SourcePath": "shared-data/tmp/pipetting-parameter-sets/process-transfer-a",
        "DestinationPath": "pipetting-parameter-sets/process-head/a",
        "ContainsSensitiveData": false
      },
      {
        "Id": "PipettingParameterSets_ProcessHeadB",
        "SourcePath": "shared-data/tmp/pipetting-parameter-sets/process-transfer-b",
        "DestinationPath": "pipetting-parameter-sets/process-head/b",
        "ContainsSensitiveData": false,
        "InstrumentType": "8800"
      },
      {
        "Id": "SoftwareUpdate",
        "SourcePath": "private-data/software-update",
        "DestinationPath": "software-update",
        "Filter": "software_inventory.json",
        "ContainsSensitiveData": false
      },
      {
        "Id": "ServiceSoftwareResults",
        "SourcePath": "private-data/ssw/Results",
        "DestinationPath": "service-software/results",
        "ContainsSensitiveData": false,
        "IsRequired": false
      },
      {
        "Id": "ServiceSoftwareCache",
        "SourcePath": "private-data/ssw/Cache",
        "DestinationPath": "service-software/cache",
        "ContainsSensitiveData": false,
        "IsRequired": false
      },
      {
        "Id": "TeachData_AmplificationPlateHandler",
        "SourcePath": "private-data/amplification-plate-handler/teaching-data",
        "DestinationPath": "teach-data/amplification-plate-handler",
        "ContainsSensitiveData": false
      },
      {
        "Id": "TeachData_InterimReagentStorageA",
        "SourcePath": "private-data/interim-reagent-storage/a/teaching-data",
        "DestinationPath": "teach-data/interim-reagent-storage/a",
        "ContainsSensitiveData": false
      },
      {
        "Id": "TeachData_InterimReagentStorageB",
        "SourcePath": "private-data/interim-reagent-storage/b/teaching-data",
        "DestinationPath": "teach-data/interim-reagent-storage/b",
        "ContainsSensitiveData": false,
        "InstrumentType": "8800"
      },
      {
        "Id": "TeachData_MainHandler",
        "SourcePath": "private-data/main-handler/teaching-data",
        "DestinationPath": "teach-data/main-handler",
        "ContainsSensitiveData": false
      },
      {
        "Id": "TeachData_ProcessingModuleControlA",
        "SourcePath": "private-data/processing-module-control/a/teaching-data",
        "DestinationPath": "teach-data/processing-module-control/a",
        "ContainsSensitiveData": false
      },
      {
        "Id": "TeachData_ProcessingModuleControlB",
        "SourcePath": "private-data/processing-module-control/b/teaching-data",
        "DestinationPath": "teach-data/processing-module-control/b",
        "ContainsSensitiveData": false,
        "InstrumentType": "8800"
      },
      {
        "Id": "TeachData_RackHandler",
        "SourcePath": "private-data/rack-handler/teaching-data",
        "DestinationPath": "teach-data/rack-handler",
        "ContainsSensitiveData": false
      },
      {
        "Id": "TeachData_TransferModuleControl",
        "SourcePath": "private-data/transfer-module-control/teaching-data",
        "DestinationPath": "teach-data/transfer-module-control",
        "ContainsSensitiveData": false
      },
      {
        "Id": "ExtractPressureDataScript",
        "SourcePath": "config/extract-pressure-data",
        "DestinationPath": "",
        "ContainsSensitiveData": false
      },
      {
        "Id": "Coredumps",
        "SourcePath": "shared-data/coredumps",
        "DestinationPath": "coredumps",
        "ContainsSensitiveData": true,
        "IsRequired": false
      },
      {
        "Id": "LoadedTestDefinitionData",
        "SourcePath": "private-data/data-manager-gateway",
        "DestinationPath": "assay-data",
        "Filter": "loaded-test-definition-data.txt",
        "ContainsSensitiveData": false
      },
      {
        "Id": "DataManagerSwVersion",
        "SourcePath": "private-data/data-manager-gateway",
        "DestinationPath": "instrument-configuration",
        "Filter": "data-manager-sw-version.data",
        "ContainsSensitiveData": false
      },
      {
        "Id": "Screenshots",
        "SourcePath": "shared-data/screenshots",
        "DestinationPath": "screenshots",
        "ContainsSensitiveData": true,
        "IsRequired": false
      },
      {
        "Id": "InstrumentConfigurationDeviceConfig",
        "SourcePath": "shared-data/device-config",
        "DestinationPath": "instrument-configuration",
        "ContainsSensitiveData": false
      },
      {
        "Id": "InstrumentConfigurationFieldBus",
        "SourcePath": "shared-config/fieldbus-definition-files",
        "DestinationPath": "instrument-configuration",
        "ContainsSensitiveData": false
      },
      {
        "Id": "ScannedFieldbusInfo",
        "SourcePath": "private-data/fieldbusgateway",
        "DestinationPath": "instrument-configuration",
        "Filter": "ScannedFieldbusInfo.json",
        "ContainsSensitiveData": false
      },
      {
        "Id": "ErrorImages",
        "SourcePath": "shared-data/error-images",
        "DestinationPath": "error-images",
        "ContainsSensitiveData": true,
        "IsRequired": false
      },
      {
        "Id": "EventStream",
        "SourcePath": "shared-data/eventstream",
        "DestinationPath": "eventstream",
        "UseNumberOfDaysOfDataToCollectFromCommand": true,
        "ContainsSensitiveData": false
      },
      {
        "Id": "Logs",
        "SourcePath": "shared-data/logs",
        "DestinationPath": "logs",
        "UseNumberOfDaysOfDataToCollectFromCommand": true,
        "ContainsSensitiveData": true
      }
    ]
  },

  "DataUpload": {
    "AutomaticFileUploadSettingsFilePath": "data/settings/automatic-file-upload.data",
    "UploadRepositoryPath": "/app/shared-data/remote-service/upload/",
    "MetadataSource": "c688800-generated",
    "Encryption": "UniversalV1",
    "EncryptionCertificate": "/app/config/certificates/rdh-encryption-newgen.crt",
    "SigningCertificate": "/app/config/certificates/x800-certificate.p12"
  },

  "SoftwareIntegrityCheck": {
      "Enabled": true,
      "Interval": "7.00:00:00"
  }
}
