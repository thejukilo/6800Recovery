<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:include schemaLocation="lib_00000207_HandlingUtilities_HUCommonConfig_0.02.00.xsd"/>
	<xs:element name="MainHandlerProcessFlow">
		<xs:annotation>
			<xs:documentation>Comment describing your root element</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="MovePatterns" type="MovePatterns"/>
				<xs:element name="LogProcessFlowPositions" type="LogProcessFlowPositions"/>
				<xs:element name="RefPointProcessFlowPositions" type="RefPointProcessFlowPositions"/>
				<xs:element name="ChangeParkPositions" type="ChangeParkPositions">
					<xs:unique name="Unique_FromTo">
						<xs:selector xpath="ChangeParkPosition"/>
						<xs:field xpath="@From"/>
						<xs:field xpath="@To"/>
					</xs:unique>
				</xs:element>
				<xs:element name="ParkPositions" type="ParkPositions"/>
				<xs:element name="AxisOffsets" type="AxisOffsets"/>
			</xs:sequence>
