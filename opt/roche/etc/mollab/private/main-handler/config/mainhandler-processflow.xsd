			<xs:selector xpath="MovePatterns/MovePattern"/>
			<xs:field xpath="@PatternName"/>
		</xs:unique>
		<xs:unique name="Unique_ParkPosName">
			<xs:selector xpath="ParkPositions/ParkPosition"/>
			<xs:field xpath="@ParkPos"/>
		</xs:unique>
		<xs:key name="Key_PatternName">
			<xs:selector xpath="MovePatterns/MovePattern"/>
			<xs:field xpath="@PatternName"/>
		</xs:key>
		<xs:keyref name="KeyRef_PatternNameTo" refer="Key_PatternName">
			<xs:selector xpath="LogProcessFlowPositions/LogProcessFlowPosition/LogPosProcessFlow/MoveTo"/>
			<xs:field xpath="PatternName"/>
		</xs:keyref>
		<xs:keyref name="KeyRef_PatternNameTurnPlate" refer="Key_PatternName">
			<xs:selector xpath="LogProcessFlowPositions/LogProcessFlowPosition/LogPosProcessFlow/TurnPlate"/>
			<xs:field xpath="PatternName"/>
		</xs:keyref>
		<xs:keyref name="KeyRef_PatternNameChangeParkPos" refer="Key_PatternName">
			<xs:selector xpath="ChangeParkPositions/ChangeParkPosition/MoveSequence"/>
			<xs:field xpath="PatternName"/>
		</xs:keyref>
		<xs:keyref name="KeyRef_PatternNameRefPoint" refer="Key_PatternName">
			<xs:selector xpath="RefPointProcessFlowPositions/RefPointProcessFlowPosition/MoveSequence"/>
			<xs:field xpath="PatternName"/>
		</xs:keyref>
		<xs:key name="Key_ParkPosName">
			<xs:selector xpath="ParkPositions/ParkPosition"/>
			<xs:field xpath="@ParkPos"/>
		</xs:key>
		<xs:keyref name="KeyRef_ParkPos" refer="Key_ParkPosName">
			<xs:selector xpath="LogProcessFlowPositions/LogProcessFlowPosition"/>
			<xs:field xpath="@ParkPos"/>
		</xs:keyref>
		<xs:keyref name="KeyRef_ParkPosRefPoint" refer="Key_ParkPosName">
			<xs:selector xpath="RefPointProcessFlowPositions/RefPointProcessFlowPosition"/>
			<xs:field xpath="@ParkPos"/>
		</xs:keyref>
