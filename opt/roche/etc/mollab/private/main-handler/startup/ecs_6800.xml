<?xml version="1.0" encoding="UTF-8"?>
<ECPSWConfiguration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="/opt/roche/config/ECPSWConfiguration.xsd">
  <ConnectedCSMs>
    <ConnectedCSM FileName="newgen-mainhandler">
      <CSMConfigureParameters>
        <System RealtimePriority="45" MiddlewarePriority="76" TraceLevel="4" Verbose="false" />
        <CSMSpecific ModuleID="201" ProviderSocket="/opt/CSM_201.sock">
          <CDIDefinition SwitchName="MotorX-cdi" DeviceName="SC_StackerHandler_2_MotorX" />
          <CDIDefinition SwitchName="MotorRZ-cdi" DeviceName="SC_StackerHandler_2_MotorRZ" />
          <CDIDefinition SwitchName="MotorZ-cdi" DeviceName="SC_StackerHandler_1_MotorZ" />
          <CDIDefinition SwitchName="MotorH-cdi" DeviceName="SC_StackerHandler_1_MotorH" />
          <CDIDefinition SwitchName="MotorRG-cdi" DeviceName="SC_StackerHandler_1_MotorRG" />
          <CDIDefinition SwitchName="MotorGripper-cdi" DeviceName="SC_StackerHandler_1_MotorGripper" />
          <CSMDefinition CSMName="MAM_HDI-id" ConnectedModuleID="998" />
          <XMLConfigurationFile XMLFileName="${UNITCONFIGPATH}/settings/config/mainhandler-config.xml" />
          <XMLConfigurationFile SwitchName="--MotionConfig" XMLFileName="${UNITCONFIGPATH}/settings/config/6800-mainhandler-motionconfig.xml" />
          <XMLConfigurationFile SwitchName="--Positioning" XMLFileName="${UNITCONFIGPATH}/settings/config/6800-mainhandler-positioning.xml" />
          <XMLConfigurationFile SwitchName="--ReferencePointOffset" XMLFileName="${ICSHAREPATH}/teaching-data/mainhandler-referencepointoffset.xml" />
          <XMLConfigurationFile SwitchName="--HeadInfo" XMLFileName="${UNITCONFIGPATH}/settings/config/6800-mainhandler-headinfo.xml" />
          <XMLConfigurationFile SwitchName="--RoutingConfig" XMLFileName="${UNITCONFIGPATH}/settings/config/mainhandler-processflow.xml" />
          <XMLConfigurationFile SwitchName="--PositionMappingPath" XMLFileName="${UNITCONFIGPATH}/settings/config/mainhandler-positionmapping.xml" />
          <CommandLineSwitch SwitchName="--CycleTime" Value="0" /> <!-- sporadic Procedure Container -->
          <CommandLineSwitch SwitchName="--telemetry_url" Value="otel:4318/v1/traces" />
          <CommandLineSwitch SwitchName="--use-rabbitmq" />
          <CommandLineSwitch SwitchName="--rabbitmq-address" Value="amqp://roche:$roche_2023!@rabbitmq-server:5672" />
          <CommandLineSwitch SwitchName="--rabbitmq-command-exchange" Value="roche.requests.dx" />
          <CommandLineSwitch SwitchName="--rabbitmq-command-queue" Value="roche.newgen.mainhandler.q" />
          <CommandLineSwitch SwitchName="--rabbitmq-event-exchange" Value="roche.events.tx" />
          <CommandLineSwitch SwitchName="--rabbitmq-event-queue" Value="roche.newgen.mainhandler.q" />
          <CommandLineSwitch SwitchName="--rabbitmq-request-exchange" Value="" />
          <CommandLineSwitch SwitchName="--rabbitmq-request-queue" Value="roche.newgen.mainhandler.q" />
          <CommandLineSwitch SwitchName="--rabbitmq-response-exchange" Value="" />
          <CommandLineSwitch SwitchName="--rabbitmq-response-queue" Value="roche.newgen.mainhandler.q" />
          <CommandLineSwitch SwitchName="--disable-report-forwarding" />
          <CommandLineSwitch SwitchName="--ecc" Value="${UNITCONFIGPATH}/settings/startup/ecc.xml" />
        </CSMSpecific>
      </CSMConfigureParameters>
    </ConnectedCSM>
  </ConnectedCSMs>
</ECPSWConfiguration>
