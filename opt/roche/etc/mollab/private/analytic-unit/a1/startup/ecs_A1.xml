<?xml version="1.0" encoding="UTF-8"?>
<ECPSWConfiguration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="/opt/roche/config/ECPSWConfiguration.xsd">
  <ConnectedCSMs>
    <ConnectedCSM FileName="newgen-analyticunit">
      <CSMConfigureParameters>
        <System RealtimePriority="72" MiddlewarePriority="77" TraceLevel="4" Verbose="false" />
        <CSMSpecific ModuleID="504" ProviderSocket="/opt/CSM_504.sock">
          <CSMDefinition CSMName="Photometer-id" ConnectedModuleID="505" ConnectToSocket="/opt/CSM_505.sock" />
          <CSMDefinition CSMName="ThermoCycler-id" ConnectedModuleID="506" ConnectToSocket="/opt/CSM_506.sock" />
          <CSMDefinition CSMName="LoadingTrayControl-id" ConnectedModuleID="517" ConnectToSocket="/opt/CSM_517.sock" />
          <CSMDefinition ConnectedModuleID="998" CSMName="MAM_HDI-id" />
          <XMLConfigurationFile XMLFileName="${UNITCONFIGPATH}/settings/config/newgen-analyticunit-parampool.xml" />
          <CommandLineSwitch SwitchName="--Photometer-socket" Value="/opt/CSM_505.sock" />
          <CommandLineSwitch SwitchName="--ThermoCycler-socket" Value="/opt/CSM_506.sock" />
          <CommandLineSwitch SwitchName="--LoadingTrayControl-socket" Value="/opt/CSM_517.sock" />
          <CommandLineSwitch SwitchName="--telemetry_url" Value="otel:4318/v1/traces" />
          <CommandLineSwitch SwitchName="--use-rabbitmq" />
          <CommandLineSwitch SwitchName="--rabbitmq-address" Value="amqp://roche:$roche_2023!@rabbitmq-server:5672" />
          <CommandLineSwitch SwitchName="--rabbitmq-command-exchange" Value="roche.requests.dx" />
          <CommandLineSwitch SwitchName="--rabbitmq-command-queue" Value="roche.newgen.analyticunit.a1.q" />
          <CommandLineSwitch SwitchName="--rabbitmq-event-exchange" Value="roche.events.tx" />
          <CommandLineSwitch SwitchName="--rabbitmq-event-queue" Value="roche.newgen.analyticunit.a1.q" />
          <CommandLineSwitch SwitchName="--rabbitmq-request-exchange" Value="" />
          <CommandLineSwitch SwitchName="--rabbitmq-request-queue" Value="roche.newgen.analyticunit.a1.q" />
          <CommandLineSwitch SwitchName="--rabbitmq-response-exchange" Value="" />
          <CommandLineSwitch SwitchName="--rabbitmq-response-queue" Value="roche.newgen.analyticunit.a1.q" />
          <CommandLineSwitch SwitchName="--ModuleId" Value="A1" />
          <CommandLineSwitch SwitchName="--disable-report-forwarding" />
          <CommandLineSwitch SwitchName="--ecc" Value="${UNITCONFIGPATH}/settings/startup/ecc.xml" />
        </CSMSpecific>
      </CSMConfigureParameters>
      <ConnectedCSMs>
        <ConnectedCSM FileName="photometer-newgen" EnableExecPrefix="false">
          <CSMConfigureParameters>
            <System RealtimePriority="45" MiddlewarePriority="81" TraceLevel="4" Verbose="false" />
            <CSMSpecific ModuleID="505" ProviderSocket="/opt/CSM_505.sock">
              <CDIDefinition SwitchName="DetControllerCtrl-cdi" DeviceName="AC_A1_DetectionControl_det" />
              <CDIDefinition SwitchName="DetFilterWheelsCtrl-cdi" DeviceName="AC_A1_DetectionControl_filterwheels" />
              <CDIDefinition SwitchName="DetPhotometerLEDCtrl-cdi" DeviceName="AC_A1_DetectionControl_photoled" />
              <CDIDefinition SwitchName="DetRefChanCtrl-cdi" DeviceName="AC_A1_DetectionControl_refch" />
              <CDIDefinition SwitchName="DetPhotometerEEPROMCtrl-cdi" DeviceName="AC_A1_DetectionControl_photoeeprom" />
              <CDIDefinition SwitchName="RedControllerCtrl-cdi" DeviceName="AC_A1_DataReduction_red" />
              <CDIDefinition SwitchName="RedCameraCtrl-cdi" DeviceName="AC_A1_DataReduction_camera" />
              <CDIDefinition SwitchName="RedAlgoCtrl-cdi" DeviceName="AC_A1_DataReduction_algo" />
              <CDIDefinition SwitchName="RedInternalCtrl-cdi" DeviceName="AC_A1_DataReduction_internal" />
              <XMLConfigurationFile XMLFileName="${UNITCONFIGPATH}/photometer-newgen/config/photometer_config.xml" />
            </CSMSpecific>
          </CSMConfigureParameters>
        </ConnectedCSM>
        <ConnectedCSM FileName="thermo-cycler-newgen" EnableExecPrefix="false">
          <CSMConfigureParameters>
            <System RealtimePriority="45" MiddlewarePriority="81" TraceLevel="4" Verbose="false" />
            <CSMSpecific ModuleID="506" ProviderSocket="/opt/CSM_506.sock">
              <CDIDefinition SwitchName="BlockCtrl-cdi" DeviceName="AC_A1_ThermoCycler_blockctrl" />
              <CDIDefinition SwitchName="CoverCtrl-cdi" DeviceName="AC_A1_ThermoCycler_coverctrl" />
              <CDIDefinition SwitchName="CyclerCtrl-cdi" DeviceName="AC_A1_ThermoCycler_cyclerctrl" />
              <CDIDefinition SwitchName="TempLoggerCtrl-cdi" DeviceName="AC_A1_ThermoCycler_temploggerctrl" />
              <CSMDefinition CSMName="MAM_HDI-id" ConnectedModuleID="998" />
              <XMLConfigurationFile XMLFileName="${UNITCONFIGPATH}/thermo-cycler-newgen/config/thermocycler_config.xml" />
            </CSMSpecific>
          </CSMConfigureParameters>
        </ConnectedCSM>
        <ConnectedCSM FileName="loading-tray-control" EnableExecPrefix="false">
          <CSMConfigureParameters>
            <System RealtimePriority="45" MiddlewarePriority="81" TraceLevel="4" Verbose="false" />
            <CSMSpecific ModuleID="517" ProviderSocket="/opt/CSM_517.sock">
              <CDIDefinition SwitchName="CoverCtrl-cdi" DeviceName="AC_A1_LoadingModul_CoverMotor" />
              <CDIDefinition SwitchName="DrawerCtrl-cdi" DeviceName="AC_A1_LoadingModul_DrawerMotor" />
              <CDIDefinition SwitchName="MonitorCtrl-cdi" DeviceName="AC_A1_LoadingModul_MonitorDevice" />
              <CSMDefinition CSMName="MAM_HDI-id" ConnectedModuleID="998" />
              <XMLConfigurationFile XMLFileName="${UNITCONFIGPATH}/loading-tray-control/config/loading-tray-control-config.xml" />
              <CommandLineSwitch SwitchName="--MotionConfig-file-path" Value="${UNITCONFIGPATH}/loading-tray-control/config/loading-tray-control-motion-config.xml" />
              <CommandLineSwitch SwitchName="--SMSConfig-file-path" Value="${UNITCONFIGPATH}/loading-tray-control/config/loading-tray-control-sms-config.xml" />
            </CSMSpecific>
          </CSMConfigureParameters>
        </ConnectedCSM>
      </ConnectedCSMs>
    </ConnectedCSM>
  </ConnectedCSMs>
</ECPSWConfiguration>