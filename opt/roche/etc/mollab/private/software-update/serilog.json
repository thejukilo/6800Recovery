{
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "shared-data/logs/SoftwareUpdate_.log",
          "outputTemplate": "[{UtcTimestamp:O}][SWU][{Level:u1}][{Logger}][{ThreadId}]{Message:lj}{Exception}[EOL]{NewLine}",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "rollOnFileSizeLimit": false,
          "fileSizeLimitBytes": 314572800
        }
      }
    ],
    "Enrich": [
      "WithThreadId",
      "WithUtcTimestamp"
    ],
    "ExcludedNamePrefixes": [
      "Roche.MolLab.SoftwareUpdate.",
      "Roche.MolLab.",
      "Launcher."
    ]
  }
}