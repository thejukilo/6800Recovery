{
  "messaging.rabbitmq": {
    "name": "SWU",
    "hostName": "rabbitmq-server",
    "distributionChannels": [
      {
        "name": "Distribution",
        "queueName": "roche.mollab.softwareupdate.q"
      }
    ],
    "publicationChannels": [
      {
        "name": "Publication"
      }
    ]
  },
  "ManufacturingData": {
    "Path": "shared-config/manufacturing-data.json"
  },
  "PackageSettings": {
    "CertificateLocation": "/app/config/certificates/integrity.cer",
    "DismissedPackagesLocation": "/app/data/dismissed_packages.json",
    "DownloadedPackagesRepositoryLocation": "/app/shared-data/remote-service/download",
    "ImportedPackagesRepositoryLocation": "/app/data/import",
    "ImportedReleaseNotesLocation": "/app/shared-data/release-notes/installable",
    "InstalledReleaseNotesLocation": "/app/shared-data/release-notes/installed",
    "InstallHistoryLocation": "/app/data/install_history.json",
    "PackagesToInstallDirectory": "/app/data/pending-updates",
    "PendingPackagesLocation": "/app/data/pending_packages.json",
    "SoftwareUpdateStatusLocation" :  "/app/data/software_update_status.json",
    "TempDownloadLocation": "/app/data/tmp/download",
    "TempExtractionLocation": "/app/data/tmp/update"
  },
  "SoftwareInventorySettings": {
    "SoftwareInventoryLocation": "/app/data/software_inventory.json"
  },
  "TimeoutSettings": {
    "DownloadAvailable": "00:01:30",
    "FirmwareUpdates": "01:00:00"
  },
  "SnapshotsSettings": {
    "MaxNumberOfStoredSnapshots": "2"
  }
}