{
  "messaging.rabbitmq": {
    "name": "RRM",
    "hostName": "rabbitmq-server",
    "distributionChannels": [
      {
        "name": "GenericResources",
        "queueName": "roche.newgen.runresourcemanagement.q",
        "AwaitMessageProcessing": true
      },
      {
        "name": "AssaySpecificResources",
        "queueName": "roche.newgen.runresourcemanagement.assayspecificresources.q",
        "AwaitMessageProcessing": true
      }
    ],
    "publicationChannels": [
      {
        "name": "Publication"
      }
    ]
  },

  "performanceMonitoring": {
    "eventCounters": {
      "enabled": true
    }
  }
}