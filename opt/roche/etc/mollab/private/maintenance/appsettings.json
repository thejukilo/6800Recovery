  "sampleTransferHeadTeachAndTightnessCheckConfiguration": {
    "pipettingParameterFileId": "ad485cca-fd60-424f-b99b-5f95969639ea"
  },

  "performanceMonitoring": {
    "eventCounters": {
      "enabled": true
    }
  },

  "maintenanceWindowPeriodicTimer": {
    "waitingTime":  "00:01:00"
  },

  "preventiveMaintenanceCounterConfiguration": {
    "processingTransferHeadDueRuns": 2400,
    "processingTransferHeadOverdueRuns": 2700,
    "instrumentPreventiveMaintenancePackage": {
      "dueRuns": 600,
      "overdueRuns": 672,
      "extensionAmount": 100
    }
  }
}