{
  "messaging.rabbitmq": {
    "name": "MNT",
    "hostName": "rabbitmq-server",
    "distributionChannels": [
      {
        "name": "Execution",
        "queueName": "roche.newgen.maintenance.execution.q",
        "logMissingSubscriptions": false
      },
      {
        "name": "Scheduling",
        "queueName": "roche.newgen.maintenance.scheduling.q",
        "AwaitMessageProcessing": true
      },
      {
        "name": "Settings",
        "queueName": "roche.newgen.maintenance.settings.q",
        "AwaitMessageProcessing": true
      },
      {
        "name": "Counters",
        "queueName": "roche.newgen.maintenance.counters.q",
        "AwaitMessageProcessing": true
      }
    ],
    "publicationChannels": [
      {
        "name": "Publication"
      }
    ]
  },

  "fileStorageRootPaths": {
    "unitData": "data"
  },

  "processingModuleTeachConfiguration": {
    "pipettingParameterFileId": "8893befa-0be7-4846-95c5-8c2c7bf6b6f1",
    "minimumLiquidWasteCapacityInCubicMeters": 0.000420,
    "minimumWashReagentReservoirVolumeInCubicMeters": 0.000170,
