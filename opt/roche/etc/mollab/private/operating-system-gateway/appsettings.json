{
  "messaging.rabbitmq": {
    "name": "OSG",
    "hostName": "rabbitmq-server",
    "distributionChannels": [
      {
        "name": "Distribution",
        "queueName": "roche.mollab.operatingsystemgateway.q"
      }
    ],
    "publicationChannels": [
      {
        "name": "Publication"
      }
    ]
  },
  "ZeroMqSettings": {
    "ConnectAddressRequestSocket": "tcp://10.0.2.2:8083",
    "ConnectAddressEventSocket": "tcp://10.0.2.2:8084",
    "EventPollingIntervalInMilliseconds": 1000
  },
  "OsalSettings": {
    "SynchronousRequestResponseTimeoutInMilliseconds": 300000,
    "AsynchronousRequestResponseTimeoutInMilliseconds": 1000,
    "MaximumNumberOfAttemptsToSendRequest": 5,
    "WaitTimeBetweenRetriesWhenOsalIsBusyInMilliseconds": 2000,
    "EstablishingOsalConnectionRequestResponseTimeoutInMilliseconds": 60000,
    "CheckSoftwareIntegrityRequestHandlerCallbackTimeoutInMilliseconds": 240000,
    "AsyncLockingTimeoutInMilliseconds": 1000
  },
  "BusinessLogicSettings": {
    "RevokeAccessOnInitialization" : true,
    "CommandExecutionOutcomeTimeoutInMilliseconds" : 60000
  },
  "FileHandlingSettings": {
    "Folders": [
      {
        "FolderPath": "shared-data/problem-reports",
        "MaximalNumberOfFiles": 5
      },
      {
        "FolderPath": "shared-data/screenshots",
        "MaximalNumberOfFiles": 20
      },
      {
        "FolderPath": "shared-data/exports",
        "MaximalNumberOfFiles": 30
      },
      {
        "FolderPath": "shared-data/service-software-checks-reports",
        "MaximalNumberOfFiles": 10
      },
      {
        "FolderPath": "shared-data/service-images",
        "MaximalNumberOfFiles": 10
      },
      {
        "FolderPath": "shared-data/error-images/rack-issues",
        "MaximalNumberOfFiles": 25
      },
      {
        "FolderPath": "shared-data/error-images/tube-issues",
        "MaximalNumberOfFiles": 25
      }
    ],
    "CleanUpFilesSamplingTimeSpan": "0:00:03.000"
  },
  "RfidTransponderDetectionSettings": {
    "PollingIntervalInMilliseconds": 1000,
    "PortName": "/dev/ttyACM0"
  },
  "performanceMonitoring": {
    "eventCounters": {
      "enabled": true
    },
    "loadAverage": {
      "enabled": true,
      "intervalSeconds": 60
    }
  },
  "diskMonitoringSettings": {
    "enabled": true,
    "timerInterval": "00:05:00",
    "disks": [
      {
        "mountPoint": "/",
        "diskType": "Root",
        "warningThresholdPercentage": 90,
        "criticalThresholdPercentage": 98
      },
      {
        "mountPoint": "/opt",
        "diskType": "Opt",
        "warningThresholdPercentage": 90,
        "criticalThresholdPercentage": 98
      },
      {
        "mountPoint": "/mnt/data",
        "diskType": "Data",
        "warningThresholdPercentage": 90,
        "criticalThresholdPercentage": 98
      }
    ]
  }
}