<?xml version="1.0" encoding="UTF-8"?>
<ECPSWConfiguration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="/opt/roche/config/ECPSWConfiguration.xsd">
  <ConnectedCSMs>
    <!-- AmplificationPlateMagazine J -->
    <ConnectedCSM FileName="newgen-amplificationplatemagazine">
      <CSMConfigureParameters>
        <System RealtimePriority="45" MiddlewarePriority="76" CPUAffinity="-1" TraceLevel="4" Verbose="false" />
        <CSMSpecific ModuleID="206" ProviderSocket="/opt/CSM_206.sock">
          <CDIDefinition SwitchName="MagazineMotor-cdi" DeviceName="PCA_ADStacker_MC_StackerMotor2" />
          <CSMDefinition CSMName="BCReader-id" ConnectedModuleID="207" ConnectToSocket="/opt/CSM_207.sock" />
          <CSMDefinition CSMName="MAM_HDI-id" ConnectedModuleID="998" />
          <XMLConfigurationFile XMLFileName="${UNITCONFIGPATH}/settings/config/amplificationplatemagazine-stacker2-motionconfig.xml" />
          <CommandLineSwitch SwitchName="--param_pool_config_path" Value="${UNITCONFIGPATH}/settings/config/amplificationplatemagazine-parampool.xml" />
          <CommandLineSwitch SwitchName="--MagazineId" Value="J" />
          <CommandLineSwitch SwitchName="--telemetry_url" Value="otel:4318/v1/traces" />
          <CommandLineSwitch SwitchName="--use-rabbitmq" />
          <CommandLineSwitch SwitchName="--rabbitmq-address" Value="amqp://roche:$roche_2023!@rabbitmq-server:5672" />
          <CommandLineSwitch SwitchName="--rabbitmq-command-exchange" Value="roche.requests.dx" />
          <CommandLineSwitch SwitchName="--rabbitmq-command-queue" Value="roche.newgen.amplificationplatemagazine.j.q" />
          <CommandLineSwitch SwitchName="--rabbitmq-event-exchange" Value="roche.events.tx" />
          <CommandLineSwitch SwitchName="--rabbitmq-event-queue" Value="roche.newgen.amplificationplatemagazine.j.q" />
          <CommandLineSwitch SwitchName="--rabbitmq-request-exchange" Value="" />
          <CommandLineSwitch SwitchName="--rabbitmq-request-queue" Value="roche.newgen.amplificationplatemagazine.j.q" />
          <CommandLineSwitch SwitchName="--rabbitmq-response-exchange" Value="" />
          <CommandLineSwitch SwitchName="--rabbitmq-response-queue" Value="roche.newgen.amplificationplatemagazine.j.q" />
          <CommandLineSwitch SwitchName="--BCReader-socket" Value="/opt/CSM_207.sock" />
          <CommandLineSwitch SwitchName="--disable-report-forwarding" />
            <CommandLineSwitch SwitchName="--ecc" Value="${UNITCONFIGPATH}/settings/startup/ecc.xml" />
        </CSMSpecific>
      </CSMConfigureParameters>
      <ConnectedCSMs>
        <ConnectedCSM FileName="barcodereader" StackSize_kbytes="128">
          <CSMConfigureParameters>
            <System RealtimePriority="46" MiddlewarePriority="76" CPUAffinity="-1" TraceLevel="4" Verbose="false" />
            <CSMSpecific ModuleID="207" ProviderSocket="/opt/CSM_207.sock">
              <CDIDefinition SwitchName="BarcodeReader-cdi" DeviceName="PCA_ADStacker_RHC_BarcodeReader2" />
              <CommandLineSwitch SwitchName="--serial_port_id" Value="1" />
              <CommandLineSwitch SwitchName="--barcode_reader_type" Value="1" /> <!-- CLP100:1, CR100:2, Mix_CR_CLP: 3, BCL8:4 -->
            </CSMSpecific>
          </CSMConfigureParameters>
        </ConnectedCSM>
      </ConnectedCSMs>
    </ConnectedCSM>
  </ConnectedCSMs>
</ECPSWConfiguration>