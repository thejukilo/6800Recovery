{
  "ConnectionCheck":{
    "ResponseTimeOut":"00:00:05",
    "ConnectionCheckInterval": "00:00:30",
    "GetDataManagerSoftwareConfigurationTimeOut": "00:01:00"
  },
  "messaging.rabbitmq": {
    "name": "DMG",
    "hostName": "rabbitmq-server",
    "distributionChannels": [
      {
        "name": "Internal",
        "queueName": "roche.newgen.datamanagergateway.q",
        "AwaitMessageProcessing": true
      },
      {
        "name": "ForwarderToDm",
        "queueName": "roche.newgen.datamanagergateway.to.dm.q",
        "IsQueueDurable": true,
        "AwaitMessageProcessing": true,
        "ConfirmMessages": true
      }
    ],
    "publicationChannels": [
      {
        "name": "Internal"
      }
    ]
  },
  "dm.messaging": {
    "Name": "Instrument-$SerialNumber<->DM",
    "CertPath": "shared-data/certificates/x800-dm-rabbitmq-auth.p12",
    "CACertPath": "shared-data/certificates/x800-dm-ca-certificate.pem",
    "Origin": "$DeviceType.$SerialNumber",
    "QueueNameOnDataManager": "roche.x800.instrument.$SerialNumber.q",
    "InstrumentSpecificIncomingExchange": "roche.dm.instrument.$DeviceType.$SerialNumber.dx"
  },
  "performanceMonitoring": {
    "eventCounters": {
      "enabled": true
    }
  }
}