  <ECPConfiguration ConfigurationID="6800_1AC_FieldbusGateway">
    <ECPSWConfigurationFile>ecs.xml</ECPSWConfigurationFile>
    <ECPHWConfigurationFile>/opt/roche/config/fieldbus-definition-files/ech.xml</ECPHWConfigurationFile>
    <BINPath>/opt/roche/bin/</BINPath>
    <FWRPath>/opt/roche/fwr/</FWRPath>
    <FirmwareUpdate BackboneAppFWR="true" CANNodeBootFWR="false" CANNodeAppFWR="true" ThirdPartyFWR="true" EnableHWIndexCheck="false" EnableHWArticleNumberCheck="true" />
