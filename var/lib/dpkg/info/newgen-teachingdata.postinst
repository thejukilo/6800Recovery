#!/bin/sh
#
# see: dh_installdeb(1)
#

set -e

# summary of how this script can be called:
#        * <postinst> `configure' <most-recently-configured-version>
#        * <old-postinst> `abort-upgrade' <new version>
#        * <conflictor's-postinst> `abort-remove' `in-favour' <package>
#          <new-version>
#        * <postinst> `abort-remove'
#        * <deconfigured's-postinst> `abort-deconfigure' `in-favour'
#          <failed-install-package> <version> `removing'
#          <conflicting-package> <version>
# for details, see http://www.debian.org/doc/debian-policy/ or
# the debian-policy package

case "$1" in
    configure)
        # Change permission / ownership of newly created directories
        DIR_TO_ADJUST="/opt/roche/var/lib/mollab/private/processing-module-control
                       /opt/roche/var/lib/mollab/private/amplification-plate-handler/teaching-data/*
                       /opt/roche/var/lib/mollab/private/interim-reagent-storage/a/teaching-data/*
                       /opt/roche/var/lib/mollab/private/interim-reagent-storage/b/teaching-data/*
                       /opt/roche/var/lib/mollab/private/main-handler/teaching-data/*
                       /opt/roche/var/lib/mollab/private/rack-handler/teaching-data/*
                       /opt/roche/var/lib/mollab/private/transfer-module-control/teaching-data/*"
        chown -R roche:roche $DIR_TO_ADJUST
    ;;
    
    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;

esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.



exit 0