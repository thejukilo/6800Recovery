#!/bin/sh
# postinst script for rlx-user-permissions
#
# see: dh_installdeb(1)

set -e

# summary of how this script can be called:
#        * <postinst> `configure' <most-recently-configured-version>
#        * <old-postinst> `abort-upgrade' <new version>
#        * <conflictor's-postinst> `abort-remove' `in-favour' <package>
#          <new-version>
#        * <postinst> `abort-remove'
#        * <deconfigured's-postinst> `abort-deconfigure' `in-favour'
#          <failed-install-package> <version> `removing'
#          <conflicting-package> <version>
# for details, see https://www.debian.org/doc/debian-policy/ or
# the debian-policy package

# source debconf library
. /usr/share/debconf/confmodule

db_get rlx-user/name
GET_NAME="${RET}"

db_get rlx-user-permissions/sudoless-gpio
GET_GPIO_ANSWER="${RET}"

db_get rlx-user-permissions/sudoless-uionetx
GET_UIONETX_ANSWER="${RET}"

db_get rlx-user-permissions/disable-usb
GET_USB_ANSWER="${RET}"


case "$1" in
    configure)
        if "${GET_GPIO_ANSWER}"
        then
            if ! getent group gpio >/dev/null; then
                groupadd gpio
                usermod -a -G gpio "${GET_NAME}"
                install -m 644 "/usr/share/${DPKG_MAINTSCRIPT_PACKAGE}/etc/udev/rules.d/99-gpio.rules" "/etc/udev/rules.d/99-gpio.rules"
            fi
        fi
        if "${GET_USB_ANSWER}"
        then
            install -m 644 "/usr/share/${DPKG_MAINTSCRIPT_PACKAGE}/etc/udev/rules.d/98-block_all_usb.rules" "/etc/udev/rules.d/98-block_all_usb.rules"
        fi
        if "${GET_UIONETX_ANSWER}"
        then
            if ! getent group uio >/dev/null; then
                groupadd uio
                usermod -a -G uio "${GET_NAME}"
                install -m 644 "/usr/share/${DPKG_MAINTSCRIPT_PACKAGE}/etc/udev/rules.d/99-uionetx.rules" "/etc/udev/rules.d/99-uionetx.rules"
            fi
        fi
        if [ "${GET_NAME}" = "roche" ]
        then
            install -m 644 "/usr/share/${DPKG_MAINTSCRIPT_PACKAGE}/etc/security/limits.d/01-roche.conf" "/etc/security/limits.d/01-roche.conf"
            install -m 644 "/usr/share/${DPKG_MAINTSCRIPT_PACKAGE}/etc/sudoers.d/01-roche" "/etc/sudoers.d/01-roche"
        fi
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.



exit 0
