#!/bin/sh
# postinst script for rlx-user
#
# see: dh_installdeb(1)

set -e

# summary of how this script can be called:
#        * <postinst> `configure' <most-recently-configured-version>
#        * <old-postinst> `abort-upgrade' <new version>
#        * <conflictor's-postinst> `abort-remove' `in-favour' <package>
#          <new-version>
#        * <postinst> `abort-remove'
#        * <deconfigured's-postinst> `abort-deconfigure' `in-favour'
#          <failed-install-package> <version> `removing'
#          <conflicting-package> <version>
# for details, see http://www.debian.org/doc/debian-policy/ or
# the debian-policy package

# source debconf library
. /usr/share/debconf/confmodule

db_get rlx-user/name
GET_NAME="${RET}"
db_get rlx-user/encrypted-format
GET_ENCRYPTED_FORMAT="${RET}"
db_get rlx-user/password
GET_PASSWORD="${RET}"
db_get rlx-user/home
GET_HOME="${RET}"
db_get rlx-user/uid
GET_UID="${RET}"
db_get rlx-user/gid
GET_GID="${RET}"
db_get rlx-user/groups
GET_GROUPS="${RET}"
db_get rlx-user/login-shell
GET_LOGIN_SHELL="${RET}"
db_get rlx-user/home-permissions
GET_HOME_PERMISSIONS="${RET}"
db_get rlx-user/umask
GET_UMASK="${RET}"

create_user()
{
    USER_CREATED=false
    if [ -n "${GET_NAME}" ]
    then
        if ! getent passwd "${GET_NAME}" >/dev/null
        then
            adduser --no-create-home --gecos "" --disabled-password "${GET_NAME}" >/dev/null
            chfn -o "umask=${GET_UMASK}" "${GET_NAME}"
            USER_CREATED=true
        fi
    else
        echo "Missing name."
        exit 1
    fi
}

check_group_existence()
{
    IFS=","
    for GROUP in ${GET_GROUPS}
    do
        if ! getent group "${GROUP}" >/dev/null
        then
            echo "Group \"${GROUP}\" does not exist."
            exit 1
        fi
    done
}

customize_user()
{
    if [ -n "${GET_PASSWORD}" ]
    then
        if "${GET_ENCRYPTED_FORMAT}"; then ENCRYPTED_OPTION="-e"; else ENCRYPTED_OPTION=""; fi
        echo "${GET_NAME}:${GET_PASSWORD}" | chpasswd "${ENCRYPTED_OPTION}"
    fi

    if [ -n "${GET_UID}" ]; then usermod -u "${GET_UID}" "${GET_NAME}"; fi
    if [ -n "${GET_GID}" ]; then groupmod -g "${GET_GID}" "${GET_NAME}"; fi
    if [ -n "${GET_GROUPS}" ]; then usermod -a -G "${GET_GROUPS}" "${GET_NAME}"; fi
    if [ -n "${GET_LOGIN_SHELL}" ]; then usermod -s "${GET_LOGIN_SHELL}" "${GET_NAME}" 2>/dev/null; fi

    if [ -n "${GET_HOME}" ]
    then
        mkdir -p "${GET_HOME}"
        cp -ar /etc/skel/. "${GET_HOME}/"
        chown -R "${GET_NAME}":"${GET_NAME}" "${GET_HOME}"
        if [ -n "${GET_HOME_PERMISSIONS}" ]; then eval chmod "${GET_HOME_PERMISSIONS}" "${GET_HOME}"; fi
        if [ "${GET_HOME}" != "/home/${GET_NAME}" ]; then usermod -d "${GET_HOME}" "${GET_NAME}"; fi
    fi
}

case "$1" in
    configure)
        create_user
        if "${USER_CREATED}"
        then
            check_group_existence
            customize_user
        fi
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.



db_stop

exit 0
