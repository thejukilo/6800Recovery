#!/bin/sh
# postinst script for libfsrverify
#
# see: dh_installdeb(1)

set -e

# summary of how this script can be called:
#        * <postinst> `configure' <most-recently-configured-version>
#        * <old-postinst> `abort-upgrade' <new version>
#        * <conflictor's-postinst> `abort-remove' `in-favour' <package>
#          <new-version>
#        * <postinst> `abort-remove'
#        * <deconfigured's-postinst> `abort-deconfigure' `in-favour'
#          <failed-install-package> <version> `removing'
#          <conflicting-package> <version>
# for details, see https://www.debian.org/doc/debian-policy/ or
# the debian-policy package

createFsrGroup() {
    # Add a new group fsrauth
    if grep -Ei "^$groupname" /etc/group > /dev/null 2>&1; then
        echo "Group $groupname already exists."
    else
        echo "Creating group $groupname"
        addgroup $groupname

        # Add root to this group
        echo "Adding root to group"
        adduser root $groupname
    fi
}

createRevocationFile() {
    if [ ! -e $filename ]; then
        echo "Creating file $filename"
        echo '0' > $filename
        echo "Changing group of the file"
        chgrp fsrauth $filename
        echo "Update file permissions"
        chmod 660 $filename
    elif [ -f $filename ]; then
        echo "$filename already exists and is a regular file."

        # Checking which group owns the file
        group=`stat -c %G $filename`
        if [ $group != $groupname ]; then
            echo "Please check file ownership, the group is $group, but should be $groupname."
            exit 1
        fi

        # Checking the permission of the file
        permissions=`stat -c %A $filename | cut -c5-6`;

        if [ "$permissions" != "rw" ]; then
            echo "Please check file permissions, they are $permissions, but should the group $groupname should be able to read and write in it."
            exit 1
        fi

        # Checking file content
        value=`cat $filename`
        echo -n "$filename contains: "
        echo $value
        echo "Please check this is the current lower key index."
    else
        echo "Error: $filename already exists, but is not a regular file."
        exit 2
    fi
}

case "$1" in
    configure)
        groupname=fsrauth
        filename=/var/fsrkeyrevocation.dat

        createFsrGroup
        createRevocationFile
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.



exit 0
