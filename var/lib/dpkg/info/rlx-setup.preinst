#!/bin/sh
#
# see: dh_installdeb(1)

set -e

# summary of how this script can be called:
#        * <new-preinst> `install'
#        * <new-preinst> `install' <old-version>
#        * <new-preinst> `upgrade' <old-version>
#        * <old-preinst> `abort-upgrade' <new-version>
# for details, see https://www.debian.org/doc/debian-policy/ or
# the debian-policy package

case "$1" in
    install|upgrade)
        # move files from rlx-osal
        mkdir -p /usr/share/rlx-setup
        dpkg-divert --divert /usr/share/rlx-setup/opt++roche++sbin++rlx-create-efi-boot.sh --rename --package rlx-setup --add /opt/roche/sbin/rlx-create-efi-boot.sh || true
        dpkg-divert --divert /usr/share/rlx-setup/opt++roche++share++rlx-osal++grub.cfg.tmpl --rename --package rlx-setup --add /opt/roche/share/rlx-osal/grub.cfg.tmpl || true

        dpkg-maintscript-helper rm_conffile /etc/initramfs-tools/hooks/efi 5.0.13~ rlx-osal -- "$@" || true
    ;;

    abort-upgrade)
    ;;

    *)
        echo "preinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

# Automatically added by dh_installinit/13.11.4
if [ "$1" = "install" ] && [ -n "$2" ] && [ -e "/etc/init.d/rlx-setup" ] ; then
	chmod +x "/etc/init.d/rlx-setup" >/dev/null || true
fi
# End automatically added section


exit 0
