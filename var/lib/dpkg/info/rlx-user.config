#!/bin/sh

set -e

# source debconf library
. /usr/share/debconf/confmodule

db_input high rlx-user/name || true
db_input high rlx-user/password || true
db_input high rlx-user/home || true
db_input high rlx-user/uid || true
db_input high rlx-user/gid || true
db_input high rlx-user/groups || true
db_input high rlx-user/login-shell || true
db_input high rlx-user/home-permissions || true
db_input high rlx-user/umask || true

db_go

exit 0
