#!/bin/sh
#
# see: dh_installdeb(1)
#

set -e

# summary of how this script can be called:
#        * <postinst> `configure' <most-recently-configured-version>
#        * <old-postinst> `abort-upgrade' <new version>
#        * <conflictor's-postinst> `abort-remove' `in-favour' <package>
#          <new-version>
#        * <postinst> `abort-remove'
#        * <deconfigured's-postinst> `abort-deconfigure' `in-favour'
#          <failed-install-package> <version> `removing'
#          <conflicting-package> <version>
# for details, see http://www.debian.org/doc/debian-policy/ or
# the debian-policy package

case "$1" in
    configure)
        # Change permission / ownership of newly created directories
        DIR_TO_ADJUST="/opt/roche/var/lib/mollab/private/data-collection
                       /mnt/data/shared/eventstream
                       /mnt/data/shared/problem-reports
                       /mnt/data/shared/system-reports
                       /mnt/tmp/private/data-collection"
        chmod -R g+w $DIR_TO_ADJUST
        chgrp -R roche $DIR_TO_ADJUST
        
        # Enable mount
        deb-systemd-helper enable opt-roche-var-lib-mollab-private-data\\x2dcollection-tmp.mount
        deb-systemd-helper enable opt-roche-var-lib-mollab-shared-eventstream.mount
        deb-systemd-helper enable opt-roche-var-lib-mollab-shared-problem\\x2dreports.mount
        deb-systemd-helper enable opt-roche-var-lib-mollab-shared-system\\x2dreports.mount
        
        # Copy the certificate used to sign the data upload files
        cp "/etc/ssl/private/x800-certificate.p12" "/opt/roche/etc/mollab/private/data-collection/certificates/x800-certificate.p12"
    ;;
    
    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;

esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.



exit 0