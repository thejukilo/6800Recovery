#!/bin/sh
# postrm script for rlx-user-permissions
#
# see: dh_installdeb(1)

set -e

# summary of how this script can be called:
#        * <postrm> `remove'
#        * <postrm> `purge'
#        * <old-postrm> `upgrade' <new-version>
#        * <new-postrm> `failed-upgrade' <old-version>
#        * <new-postrm> `abort-install'
#        * <new-postrm> `abort-install' <old-version>
#        * <new-postrm> `abort-upgrade' <old-version>
#        * <disappearer's-postrm> `disappear' <overwriter>
#          <overwriter-version>
# for details, see https://www.debian.org/doc/debian-policy/ or
# the debian-policy package

# source debconf library
. /usr/share/debconf/confmodule

db_get rlx-user/name
GET_NAME="${RET}"

db_get rlx-user-permissions/sudoless-gpio
GET_GPIO_ANSWER="${RET}"

db_get rlx-user-permissions/sudoless-uionetx
GET_UIONETX_ANSWER="${RET}"

db_get rlx-user-permissions/disable-usb
GET_USB_ANSWER="${RET}"

case "$1" in
    purge)
        if "${GET_GPIO_ANSWER}"
        then
            gpasswd -d "${GET_NAME}" gpio
            delgroup gpio --only-if-empty
            rm "/etc/udev/rules.d/99-gpio.rules"
        fi
        if "${GET_USB_ANSWER}"
        then
            rm "/etc/udev/rules.d/98-block_all_usb.rules"
        fi
        if "${GET_UIONETX_ANSWER}"
        then
            gpasswd -d "${GET_NAME}" uio
            delgroup uio --only-if-empty
            rm "/etc/udev/rules.d/99-uionetx.rules"
        fi
        if [ "${GET_NAME}" = "roche" ]
        then
            rm -f "/etc/security/limits.d/01-roche.conf"
            rm -f "/etc/sudoers.d/01-roche"
        fi
        db_purge
    ;;

    remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
    ;;

    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

# Automatically added by dh_installdebconf/13.11.4
if [ "$1" = purge ] && [ -e /usr/share/debconf/confmodule ]; then
	. /usr/share/debconf/confmodule
	db_purge
fi
# End automatically added section


exit 0
