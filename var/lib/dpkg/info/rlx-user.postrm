#!/bin/sh
# postrm script for rlx-user
#
# see: dh_installdeb(1)

set -e

# summary of how this script can be called:
#        * <postrm> `remove'
#        * <postrm> `purge'
#        * <old-postrm> `upgrade' <new-version>
#        * <new-postrm> `failed-upgrade' <old-version>
#        * <new-postrm> `abort-install'
#        * <new-postrm> `abort-install' <old-version>
#        * <new-postrm> `abort-upgrade' <old-version>
#        * <disappearer's-postrm> `disappear' <overwriter>
#          <overwriter-version>
# for details, see http://www.debian.org/doc/debian-policy/ or
# the debian-policy package

# source debconf library
. /usr/share/debconf/confmodule

db_get rlx-user/name
GET_NAME="${RET}"
db_get rlx-user/home
GET_HOME="${RET}"

remove_home_directory()
{
    if [ -d "${GET_HOME}" ]
    then
        if expr "${GET_HOME}" : '^\(/home/.\+\)$' >/dev/null
        then
            rm -rf "${GET_HOME}"
        else
            echo "WARNING: home directory not removed, because it is not in /home"
        fi
    else
        echo "WARNING: home directory not removed, because it does not exist"
    fi
}

case "$1" in
    remove)
        deluser "${GET_NAME}" >/dev/null
    ;;

    purge)
        remove_home_directory
        db_purge
    ;;

    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
    ;;

    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

# Automatically added by dh_installdebconf/13.11.4
if [ "$1" = purge ] && [ -e /usr/share/debconf/confmodule ]; then
	. /usr/share/debconf/confmodule
	db_purge
fi
# End automatically added section


db_stop

exit 0
