#!/bin/sh
#
# see: dh_installdeb(1)
#

set -e

# summary of how this script can be called:
#        * <postinst> `configure' <most-recently-configured-version>
#        * <old-postinst> `abort-upgrade' <new version>
#        * <conflictor's-postinst> `abort-remove' `in-favour' <package>
#          <new-version>
#        * <postinst> `abort-remove'
#        * <deconfigured's-postinst> `abort-deconfigure' `in-favour'
#          <failed-install-package> <version> `removing'
#          <conflicting-package> <version>
# for details, see http://www.debian.org/doc/debian-policy/ or
# the debian-policy package

case "$1" in
    configure)

        # Change permission / ownership of newly created directories
        DIR_TO_ADJUST="/opt/roche/var/lib/mollab/shared/logs/rsa2l
                       /opt/roche/var/lib/mollab/private/rsa2l/config
                       /opt/roche/var/lib/mollab/private/rsa2l/upload
                       /mnt/data/shared/remote-service
                       /mnt/data/shared/remote-service/upload
                       /mnt/data/shared/remote-service/failed-upload
                       /mnt/data/shared/remote-service/download
                       /mnt/data/shared/remote-service/failed-download"
        chmod g+w $DIR_TO_ADJUST
        chgrp roche $DIR_TO_ADJUST

        # Enable mount
        deb-systemd-helper enable opt-roche-var-lib-mollab-shared-remote\\x2dservice.mount

        # Copy config file if needed
        RSA2LConfigTargetPath=/opt/roche/var/lib/mollab/private/rsa2l/config/RSA2L_Configuration.json
        if [ ! -f $RSA2LConfigTargetPath ] ; then
            cp opt/roche/etc/mollab/private/rsa2l/RSA2L_Configuration.json.template $RSA2LConfigTargetPath
            chown roche:roche $RSA2LConfigTargetPath
        fi
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;

esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.



exit 0