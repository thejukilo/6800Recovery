[Unit]
Description=Generate SSH keys for user roche
ConditionPathExists=!/opt/roche/home/.ssh/id_rsa

[Service]
Type=oneshot
User=roche
ExecStart=/usr/bin/ssh-keygen -t rsa -f /opt/roche/home/.ssh/id_rsa -q -N ""
ExecStart=/usr/bin/ssh-keygen -t ed25519 -f /opt/roche/home/.ssh/id_ed25519 -q -N ""

[Install]
WantedBy=multi-user.target
